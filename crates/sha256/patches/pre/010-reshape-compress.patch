+//! PATCHED: the body of `Sha256Compress::compress` in a shape hax's Lean backend translates.
+//!
+//! The extractor has no model of `transmute` or of the chunked iterators the original uses.
+//! Plonky3-lean, docs/extractor-issues.md, 14.
+
+use crate::H256_256;
+
+/// The compression of `input` from the initial hash value: what `Sha256Compress::compress` returns.
+#[cfg_attr(not(hax_backend_lean), allow(dead_code))]
+pub(crate) fn compress(input: [[u8; 32]; 2]) -> [u8; 32] {
+    // The two halves, in order, as one 64-byte block.
+    let mut block = [0u8; 64];
+    for i in 0..32 {
+        block[i] = input[0][i];
+        block[32 + i] = input[1][i];
+    }
+
+    let mut state = H256_256;
+    sha2::block_api::compress256(&mut state, &[block]);
+
+    // Each state word, big-endian.
+    let mut output = [0u8; 32];
+    for i in 0..8 {
+        let bytes = state[i].to_be_bytes();
+        for j in 0..4 {
+            output[4 * i + j] = bytes[j];
+        }
+    }
+    output
+}
+
+#[cfg(test)]
+mod tests {
+    use p3_symmetric::PseudoCompressionFunction;
+    use proptest::prelude::*;
+
+    use crate::Sha256Compress;
+
+    fn check(input: [[u8; 32]; 2]) {
+        assert_eq!(super::compress(input), Sha256Compress.compress(input));
+    }
+
+    #[test]
+    fn reshaped_compress_matches_on_edge_inputs() {
+        check([[0; 32]; 2]);
+        check([[0xff; 32]; 2]);
+        check([[0; 32], [0xff; 32]]);
+        check([[0xff; 32], [0; 32]]);
+        check(core::array::from_fn(|h| core::array::from_fn(|i| (32 * h + i) as u8)));
+    }
+
+    proptest! {
+        #[test]
+        fn reshaped_compress_matches(input in any::<[[u8; 32]; 2]>()) {
+            prop_assert_eq!(super::compress(input), Sha256Compress.compress(input));
+        }
+    }
+}
