      then ok core.option.Option.None
      else
        if collapse_challenges != log_height
        then ok core.option.Option.None
        else
          if (log_height = 0#usize) != (layer_count = 0#usize)
          then ok core.option.Option.None
          else
            ok (core.option.Option.Some
              {
                log_height,
                tree_count,
                sumcheck_rounds,
                layer_count,
                collapse_challenges
              })

