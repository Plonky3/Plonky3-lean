+// PATCHED: the differential test of the index-based selection against the
+// term-copying one, in the normal build.
+#[cfg(test)]
+mod pre_patch_020 {
+    use super::*;
+
+    #[test]
+    fn binding_index_selects_the_binding_term() {
+        let mut x = 0x9e37_79b9_7f4a_7c15_u64;
+        let mut next = || {
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            x
+        };
+        const LABELS: [&str; NUM_TERMS] = ["a", "b", "c", "d", "e", "f", "g"];
+        for round in 0..20_000 {
+            // Small values force ties, so the earliest-minimum rule is exercised.
+            let modulus = if round % 2 == 0 { 4 } else { u64::MAX };
+            let mut terms = [SecurityTerm::new("", 0); NUM_TERMS];
+            for (i, term) in terms.iter_mut().enumerate() {
+                *term = SecurityTerm::new(LABELS[i], next() % modulus);
+            }
+            let report = SecurityReport::new(terms);
+            assert_eq!(report.terms()[report.binding_index()], report.binding_term());
+        }
+    }
+}
