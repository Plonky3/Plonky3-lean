+// PATCHED: the position of the first minimum, compiled in every build.
+// It is the binding-term loop, run over plain bit counts.
+#[allow(dead_code)]
+const fn first_minimum(bits: [u64; NUM_TERMS]) -> usize {
+    let mut binding = 0;
+    let mut index = 1;
+    while index < NUM_TERMS {
+        if bits[index] < bits[binding] {
+            binding = index;
+        }
+        index += 1;
+    }
+    binding
+}
