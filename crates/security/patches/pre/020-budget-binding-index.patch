+// PATCHED: the position of the first minimum, compiled in every build; the loop of
+// `binding_term` over plain bit counts, for `binding_index`.
+#[allow(dead_code)]
+const fn first_minimum(bits: [u64; NUM_TERMS]) -> usize {
+    let mut binding = 0;
+    let mut index = 1;
+    while index < NUM_TERMS {
+        if bits[index] < bits[binding] {
+            binding = index;
+        }
+        index += 1;
+    }
+    binding
+}
