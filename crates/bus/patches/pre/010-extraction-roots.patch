+    boundary.contains_row(row, height)
+}
+
+pub const fn access_payload_width(statement: &RamStatement) -> usize {
+    statement.access_payload_width()
+}
+
+pub const fn image_payload_width(statement: &RamStatement) -> usize {
+    statement.image_payload_width()
+}
