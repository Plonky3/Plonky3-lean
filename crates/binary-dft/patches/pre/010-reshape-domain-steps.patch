+//! PATCHED: bodies in a shape hax's Lean backend translates.
+//!
+//! Aeneas gives a closure that updates a captured variable a back function that CoreModels cannot take.
+//! Plonky3-lean, docs/extractor-issues.md, 60 and 244.
+//!
+//! The body here runs a plain loop and makes the same calls, in the same order, as the original.
+
+use alloc::vec::Vec;
+
+use p3_binary_field::TowerLevel;
+
+/// The steps between consecutive even domain points, from a plain loop.
+///
+/// # Panics
+///
+/// Panics if `count` is at least the bit width of the level.
+#[cfg_attr(not(hax_backend_lean), allow(dead_code))]
+pub(crate) fn domain_point_steps<F: TowerLevel>(count: usize) -> Vec<F> {
+    let mut steps = Vec::new();
+
+    // Each entry is the previous one plus the next basis vector up.
+    let mut point = F::ZERO;
+    for r in 0..count {
+        point += F::cantor_basis(r + 1);
+        steps.push(point);
+    }
+    steps
+}
+
+#[cfg(test)]
+mod tests {
+    use p3_binary_field::{
+        BinaryField2, BinaryField8, BinaryField32, BinaryField128, Gf2, Ghash128, Poly64,
+        TowerLevel,
+    };
+
+    use crate::domain_point_steps;
+
+    /// The shipped table and the loop agree at every count below the bit width.
+    fn check<F: TowerLevel>() {
+        // Fixture state: counts 0 ..= 2^b - 1, the whole range that does not panic.
+        //
+        //     count 0       -> []
+        //     count 2^b - 1 -> the last entry adds the top basis vector
+        for count in 0..(1usize << F::LOG_BITS) {
+            assert_eq!(
+                super::domain_point_steps::<F>(count),
+                domain_point_steps::<F>(count),
+                "count {count}"
+            );
+        }
+    }
+
+    #[test]
+    fn the_loop_matches_the_shipped_table() {
+        check::<Gf2>();
+        check::<BinaryField2>();
+        check::<BinaryField8>();
+        check::<BinaryField32>();
+        check::<BinaryField128>();
+        check::<Ghash128>();
+        check::<Poly64>();
+    }
+
+    #[test]
+    #[should_panic(expected = "Cantor basis index out of range")]
+    fn the_loop_panics_at_the_bit_width() {
+        // Invariant: the table asks for basis vector `count`, which a level of 2^b bits lacks.
+        let _ = super::domain_point_steps::<BinaryField8>(8);
+    }
+}
