 def log2_ceil_usize (n : Std.Usize) : RustM Std.Usize := do
-  let i ← core.num.Usize.saturating_sub n 1#usize
+  -- PATCHED: the exposed model of `saturating_sub` (was `core.num.Usize.saturating_sub`)
