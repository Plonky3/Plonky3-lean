    | shift.ShiftKind.RotateRight => ok false
    | shift.ShiftKind.Lane32LogicalLeft => ok false
    | shift.ShiftKind.Lane32LogicalRight => ok false
    | shift.ShiftKind.Lane32ArithmeticRight => ok false
    | shift.ShiftKind.Lane32RotateRight => ok false
  | shift.ShiftKind.Lane32ArithmeticRight =>
    match outer.kind with
    | shift.ShiftKind.LogicalLeft => ok false
    | shift.ShiftKind.LogicalRight =>
