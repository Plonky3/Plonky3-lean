# Patch:        030-reducible-closure-state
# Phase:        post
# Target:       extraction/P3Word/Extraction/Types.lean
# Hunks:        3
# Class:        reshape
# Gap:          docs/extractor-issues.md 243 (aeneas leaves the state of a
#               closure with a pair of captures semireducible).
# Cost:         none. Only the reducibility of three type abbreviations changes.
# Upstreamable: yes: aeneas could mark every closure state reducible.
# Drop when:    aeneas marks a closure state with several captures reducible.
#
# aeneas marks the state type of a closure reducible when it captures one value.
# With two captures, the state is a pair, and the definition is left semireducible.
# The call site then passes a pair where the closure state is expected.
# `simp` rejects any goal containing it, since the term is not type-correct at reducible transparency.
# The patch marks the three such states reducible.
#
--- a/extraction/P3Word/Extraction/Types.lean
+++ b/extraction/P3Word/Extraction/Types.lean
@@ -90,6 +90,8 @@
 
 /-- [p3_word::component::{p3_word::component::CompositionError}::bound_segment::{closure}]
     Source: 'word/src/component.rs', lines 200:35-200:76 -/
+-- PATCHED: reducible, as aeneas marks every other closure state.
+@[reducible]
 def component.CompositionError.bound_segment.closure :=
   index.Segment × Std.Usize
 
@@ -233,6 +235,8 @@
 
 /-- [p3_word::component::reshaped::{p3_word::component::Composition<W>[TraitClause0]}::bound_family::{closure}]
     Source: 'word/src/component_reshaped.rs', lines 102:35-102:89 -/
+-- PATCHED: reducible, as aeneas marks every other closure state.
+@[reducible]
 def component.reshaped.Composition.bound_family.closure (W : Type _) :=
   system.ConstraintKind × Std.Usize
 
@@ -307,6 +311,8 @@
 
 /-- [p3_word::constraint::{p3_word::constraint::Operand<W>[TraitClause0]}::evaluate::{closure}]
     Source: 'word/src/constraint.rs', lines 66:28-70:17 -/
+-- PATCHED: reducible, as aeneas marks every other closure state.
+@[reducible]
 def constraint.Operand.evaluate.closure (W : Type _) :=
   index.ValueIndex × Slice W
 
