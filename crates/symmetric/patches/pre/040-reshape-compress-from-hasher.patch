+/// What the compression function built from a hasher returns on `input`.
+#[cfg_attr(not(hax_backend_lean), allow(dead_code))]
+pub(crate) fn compress_from_hasher<T, H, const N: usize, const CHUNK: usize>(
+    hasher: &H,
+    input: [[T; CHUNK]; N],
+) -> [T; CHUNK]
+where
+    T: Clone,
+    H: CryptographicHasher<T, [T; CHUNK]>,
+{
+    // The chunks, in order, as one run of N * CHUNK items.
+    //
+    //     [[a, b], [c, d]]  ->  [a, b, c, d]
+    let mut items = Vec::new();
+    for chunk in input {
+        for x in chunk {
+            items.push(x);
+        }
+    }
+    hasher.hash_iter(items)
+}
