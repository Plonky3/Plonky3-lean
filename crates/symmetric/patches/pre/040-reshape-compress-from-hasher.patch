+    fn check_compress<const N: usize, const CHUNK: usize>(input: [[u64; CHUNK]; N]) {
+        // A padding-free sponge over the mixing permutation is order sensitive, as a hasher must be.
+        let hasher = PaddingFreeSponge::<Mix, 16, 8, CHUNK>::new(Mix);
+        let original = CompressionFunctionFromHasher::<_, N, CHUNK>::new(hasher.clone()).compress(input);
+        let reshaped = super::compress_from_hasher::<u64, _, N, CHUNK>(&hasher, input);
+        assert_eq!(original, reshaped);
+    }
+
+    #[test]
+    fn compress_from_hasher_matches_on_edge_inputs() {
+        // Fixture state: distinct items, so a reordering of chunks or of items shows up.
+        //
+        //     N = 2, CHUNK = 4:  [[0, 1, 2, 3], [4, 5, 6, 7]]  ->  hash of [0, 1, ..., 7]
+        check_compress::<2, 4>(core::array::from_fn(|n| core::array::from_fn(|i| (4 * n + i) as u64)));
+        check_compress::<3, 2>(core::array::from_fn(|n| core::array::from_fn(|i| (2 * n + i) as u64)));
+        check_compress::<1, 8>([[u64::MAX; 8]]);
+        check_compress::<2, 1>([[0], [1]]);
+        check_compress::<4, 8>([[0; 8]; 4]);
+    }
+
+    proptest! {
+        #[test]
+        fn compress_from_hasher_matches(input in any::<[[u64; 4]; 2]>(), wide in any::<[[u64; 8]; 3]>()) {
+            check_compress::<2, 4>(input);
+            check_compress::<3, 8>(wide);
+        }
+    }
