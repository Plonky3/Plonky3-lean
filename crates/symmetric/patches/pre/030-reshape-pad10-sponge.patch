+/// What the 10-padded sponge returns on `input`.
+#[cfg_attr(not(hax_backend_lean), allow(dead_code))]
+pub(crate) fn pad10_hash<T, P, D, I, const WIDTH: usize, const RATE: usize, const OUT: usize>(
+    permutation: &P,
+    padding_derangement: &D,
+    input: I,
+) -> [T; OUT]
+where
+    T: Default + Copy,
+    P: CryptographicPermutation<[T; WIDTH]>,
+    D: Derangement<T>,
+    I: IntoIterator<Item = T>,
+{
+    // Start from the all-zero state.
+    let mut state = [T::default(); WIDTH];
+    let mut input = input.into_iter();
+
+    // Rate position the next element overwrites.
+    let mut i = 0;
+
+    // Whether a full block sits in the rate, not yet permuted.
+    //
+    // Its permutation waits for the next element.
+    // With no next element, that block takes the capacity padding instead.
+    let mut full = false;
+    while let Some(x) = input.next() {
+        if full {
+            permutation.permute_mut(&mut state);
+            full = false;
+        }
+        state[i] = x;
+        i += 1;
+        if i == RATE {
+            i = 0;
+            full = true;
+        }
+    }
+
+    if full {
+        // The input ended on a block boundary: apply the derangement to the first capacity element.
+        state[RATE] = padding_derangement.permute(state[RATE]);
+    } else {
+        // A partial block, or the empty input: the sentinel d(0) at position i, then zeros.
+        //
+        //     [a]    RATE = 3  ->  [a, d(0), 0 | cap...]
+        state[i] = padding_derangement.permute(T::default());
+        let mut j = i + 1;
+        while j < RATE {
+            state[j] = T::default();
+            j += 1;
+        }
+    }
+
+    // Permute the padded state and squeeze.
+    permutation.permute_mut(&mut state);
+    state[..OUT].try_into().unwrap()
+}
+
