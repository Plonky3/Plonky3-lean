+    fn check_pad10<const WIDTH: usize, const RATE: usize, const OUT: usize>(input: &[u64]) {
+        // An increment of 5 rather than 1, so the sentinel is not mistaken for a count.
+        let sponge =
+            Pad10Sponge::<u64, Mix, Increment<u64>, WIDTH, RATE, OUT>::new(Mix, Increment::new(5));
+        let original: [u64; OUT] = sponge.hash_iter(input.iter().copied());
+        let reshaped: [u64; OUT] = super::pad10_hash::<u64, Mix, _, _, WIDTH, RATE, OUT>(
+            &Mix,
+            &Increment::new(5),
+            input.iter().copied(),
+        );
+        assert_eq!(original, reshaped, "length {}", input.len());
+    }
+
+    #[test]
+    fn pad10_matches_at_every_length_around_the_rate() {
+        // Same fixture as the padding-free test: every length from 0 to 3 * RATE + 1.
+        let input: Vec<u64> = (1..=40).collect();
+        for len in 0..=13 {
+            check_pad10::<4, 3, 2>(&input[..len]);
+            check_pad10::<4, 1, 1>(&input[..len]);
+            check_pad10::<8, 4, 4>(&input[..len]);
+            check_pad10::<16, 8, 8>(&input[..len]);
+        }
+    }
+
+    proptest! {
+        #[test]
+        fn pad10_matches(input in prop::collection::vec(any::<u64>(), 0..40)) {
+            check_pad10::<4, 3, 2>(&input);
+            check_pad10::<8, 4, 4>(&input);
+            check_pad10::<12, 8, 4>(&input);
+        }
+    }
 }
