# Patch:        030-name-anonymous-const-assertions
# Phase:        post
# Target:       extraction/P3BabyBear/Extraction/Funs.lean
# Hunks:        9
# Class:        rename
# Gap:          docs/extractor-issues.md 5: aeneas names anonymous `const _: ()
#               = assert!(..)` items `__1`, `__2`, ..., which mathlib's
#               `linter.style.nameCheck` rejects (one warning each).
# Cost:         none. Renames only; the bodies are untouched.
# Upstreamable: yes: aeneas could generate names without a double underscore.
# Drop when:    aeneas generates a name without a double underscore.
#
# baby-bear's Poseidon tables carry their length invariants as anonymous
# const assertions (eleven of them: two in poseidon1.rs, nine in poseidon2.rs).
# aeneas names the first in each module `_` and the rest `__1`, `__2`, ….
# This patch renames the nine `__N` definitions to `const_check_N`. A `__`
# name is valid Lean, but mathlib's `nameCheck` warns on each one, and the
# build must stay warning-clean without switching linters off. The `_` names
# do not warn, so they are left as `poseidon1._` and `poseidon2._`; Plonky3Lean
# proves the nine renamed checks and not those two.
#
--- a/extraction/P3BabyBear/Extraction/Funs.lean
+++ b/extraction/P3BabyBear/Extraction/Funs.lean
@@ -1357,7 +1357,7 @@
 /-- [p3_baby_bear::poseidon1::_#1]
     Source: 'baby-bear/src/poseidon1.rs', lines 70:0-73:2 -/
 @[global_simps, irreducible]
-def poseidon1.__1 : RustM Unit := do
+def poseidon1.const_check_1 : RustM Unit := do -- PATCHED: aeneas emitted `poseidon1.__1`
   let a ← poseidon1.BABYBEAR_POSEIDON1_RC_24
   let s ← core.array.Array.as_slice a
   let i ← core.slice.Slice.len s
