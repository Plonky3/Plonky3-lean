--- /dev/null
+++ b/baby-bear/tests/pre_patch_050.rs
@@ -0,0 +1,51 @@
+//! PATCHED: added by Plonky3-lean pre-patch 050 (`field-cfg-packed-ext-powers`).
+//!
+//! The patch removes the packed powers of an extension element from the extracted variant only.
+//!
+//! In a normal build the method must still be reachable through the extension field bound alone.
+//!
+//! Its lanes, read in order, must be the powers 1, b, b^2, ... of the base b.
+
+use p3_baby_bear::BabyBear;
+use p3_field::extension::BinomialExtensionField;
+use p3_field::{
+    BasedVectorSpace, ExtensionField, Field, PackedFieldExtension, PackedValue,
+    PrimeCharacteristicRing,
+};
+
+type F = BabyBear;
+
+const W: usize = <<F as Field>::Packing as PackedValue>::WIDTH;
+
+// The first `n` packed powers of `b`, unpacked lane by lane.
+fn packed_powers<EF: ExtensionField<F>>(b: EF, n: usize) -> Vec<EF> {
+    EF::ExtensionPacking::packed_ext_powers(b)
+        .take(n)
+        .flat_map(|p| (0..W).map(move |l| p.extract(l)))
+        .collect()
+}
+
+// Checks the lanes against repeated scalar multiplication.
+fn check<EF: ExtensionField<F>>(b: EF) {
+    // Fixture state: 3 packed elements, so 3 W lanes, holding b^0 .. b^(3 W - 1).
+    let lanes = packed_powers(b, 3);
+    assert_eq!(lanes.len(), 3 * W);
+    let mut power = EF::ONE;
+    for (i, &x) in lanes.iter().enumerate() {
+        assert_eq!(x, power, "power {i}");
+        power *= b;
+    }
+}
+
+#[test]
+fn packed_ext_powers_is_the_powers_in_lane_order() {
+    // The degree-1 case: the base field is its own extension.
+    check(F::from_u32(7));
+    // Degrees 4 and 5, with a base that has every coordinate nonzero.
+    check(BinomialExtensionField::<F, 4>::from_basis_coefficients_fn(
+        |d| F::from_usize(3 + d),
+    ));
+    check(BinomialExtensionField::<F, 5>::from_basis_coefficients_fn(
+        |d| F::from_usize(11 + 2 * d),
+    ));
+}
