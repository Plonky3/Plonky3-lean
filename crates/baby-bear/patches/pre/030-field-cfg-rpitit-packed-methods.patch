+/// PATCHED: under hax's Lean backend, [`PackedFieldExtension::to_ext_iter`] is
+/// moved here (same body) so that `PackedFieldExtension` declares no hidden GAT.
+/// It is blanket-implemented, so `EF::ExtensionPacking::to_ext_iter(..)`
+/// resolves unchanged wherever this trait is in scope. Normal builds do not
+/// have this trait.
+#[cfg(hax_backend_lean)]
+pub trait PackedFieldExtensionIter<
+    BaseField: Field,
+    ExtField: ExtensionField<BaseField, ExtensionPacking = Self>,
+>: PackedFieldExtension<BaseField, ExtField>
+{
+    /// See [`PackedFieldExtension`]'s normal-build `to_ext_iter`.
+    #[inline]
+    #[must_use]
+    fn to_ext_iter(iter: impl IntoIterator<Item = Self>) -> impl Iterator<Item = ExtField> {
+        iter.into_iter()
+            .flat_map(|x| (0..BaseField::Packing::WIDTH).map(move |lane| x.extract(lane)))
+    }
+}
