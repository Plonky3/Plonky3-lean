diff --git a/baby-bear/tests/pre_patch_020.rs b/baby-bear/tests/pre_patch_020.rs
new file mode 100644
--- /dev/null
+++ b/baby-bear/tests/pre_patch_020.rs
@@ -0,0 +1,44 @@
+//! PATCHED: added by Plonky3-lean pre-patch 020 (`field-cfg-raw-data-serializable-supertrait`).
+//!
+//! In a normal build `Field` reaches `RawDataSerializable` through `FieldRawData`,
+//! so `F: Field` must still imply `F: RawDataSerializable`, and the extension
+//! fields' `RawDataSerializable` impls, which now state the bound on `F`
+//! themselves, must serialise exactly as before.
+
+use p3_baby_bear::BabyBear;
+use p3_field::extension::BinomialExtensionField;
+use p3_field::{BasedVectorSpace, Field, PrimeCharacteristicRing, PrimeField32};
+
+/// Serialises through the `Field` bound alone, so this compiles only while
+/// `Field` implies `RawDataSerializable`.
+fn bytes_through_field<F: Field>(x: F) -> Vec<u8> {
+    x.into_bytes().into_iter().collect()
+}
+
+fn num_bytes_through_field<F: Field>() -> usize {
+    F::NUM_BYTES
+}
+
+#[test]
+fn field_implies_raw_data_serializable() {
+    for v in [0, 1, 2, 0x7800_0000, 123_456_789] {
+        let x = BabyBear::from_u32(v);
+        // A `MontyField31` serialises its unique (Montgomery-form) `u32`, little-endian.
+        assert_eq!(bytes_through_field(x), x.to_unique_u32().to_le_bytes());
+    }
+    assert_eq!(num_bytes_through_field::<BabyBear>(), 4);
+}
+
+#[test]
+fn extension_bytes_are_the_coefficients_bytes() {
+    type EF = BinomialExtensionField<BabyBear, 4>;
+    let x: EF = BasedVectorSpace::<BabyBear>::from_basis_coefficients_fn(|i| {
+        BabyBear::from_u32(1_000_003 * i as u32 + 7)
+    });
+    let expected: Vec<u8> = BasedVectorSpace::<BabyBear>::as_basis_coefficients_slice(&x)
+        .iter()
+        .flat_map(|c| c.to_unique_u32().to_le_bytes())
+        .collect();
+    assert_eq!(bytes_through_field(x), expected);
+    assert_eq!(num_bytes_through_field::<EF>(), 16);
+}
