+//! PATCHED: added by Plonky3-lean pre-patch 040 (`field-cfg-rpitit-bit-plane-expansion`).
+//!
+//! The patch removes `Field::prepare_bit_plane_expansion` from the extracted
+//! variant only. In a normal build it must still be a method of `Field`,
+//! reachable through the bound alone, with its documented default: fields
+//! without a target-specific expansion return `None`.
+
+use p3_baby_bear::BabyBear;
+use p3_field::extension::BinomialExtensionField;
+use p3_field::{Field, PrimeCharacteristicRing};
+
+fn has_expansion<F: Field>(weights: &[F; 64]) -> bool {
+    F::prepare_bit_plane_expansion(weights).is_some()
+}
+
+#[test]
+fn bit_plane_expansion_is_a_field_method_with_the_default() {
+    let weights: [BabyBear; 64] = core::array::from_fn(|i| BabyBear::from_usize(i + 1));
+    assert!(!has_expansion(&weights));
+    let ext_weights: [BinomialExtensionField<BabyBear, 4>; 64] =
+        core::array::from_fn(|i| BinomialExtensionField::from_usize(i + 1));
+    assert!(!has_expansion(&ext_weights));
+}
