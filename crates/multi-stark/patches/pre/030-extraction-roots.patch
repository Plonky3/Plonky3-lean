+//! PATCHED: extraction roots for hax's Lean backend, compiled only under `cfg(hax_backend_lean)`.
+//!
+//! Aeneas drops a method that no free function calls (Plonky3-lean, docs/extractor-issues.md, 4).
+//! Each function here calls one item and does nothing else, so that the item's own body is extracted.
+//!
+//! The field stays generic.
+//! The Lean model then quantifies over every implementation of it.
+
+use alloc::vec::Vec;
+
+use p3_field::Field;
+
+use crate::opening::OpeningClaims;
+use crate::selectors::BoundaryEvals;
+use crate::zerocheck::transcript::ZerocheckShape;
+
+pub fn boundary_at<EF: Field>(rs: &[EF]) -> BoundaryEvals<EF> {
+    BoundaryEvals::at(rs)
+}
+
+pub fn boundary_apply<EF: Field>(b: &mut BoundaryEvals<EF>, r: EF) {
+    b.apply(r)
+}
+
+pub fn boundary_from_row<EF: Field>(row: usize, height: usize) -> BoundaryEvals<EF> {
+    BoundaryEvals::from_row(row, height)
+}
+
+pub fn boundary_from_row_with_prefix<EF: Field>(
+    row: usize,
+    height: usize,
+    prefix: BoundaryEvals<EF>,
+) -> BoundaryEvals<EF> {
+    BoundaryEvals::from_row_with_prefix(row, height, prefix)
+}
+
+pub fn next_row<EF: Field>(claims: &OpeningClaims<EF>, width: usize) -> Vec<EF> {
+    claims.next_row(width)
+}
+
+pub fn free_coordinates(shape: &ZerocheckShape) -> usize {
+    shape.free_coordinates()
+}
