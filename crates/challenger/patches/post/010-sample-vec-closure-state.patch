+-- PATCHED: `(0..n).map(|_| self.sample()).collect()`, as a loop.
+-- aeneas threads `self` through `map` with a back function, which CoreModels' `map` lacks.
+@[rust_loop_body]
+def CanSample.sample_vec.default_loop.body
+  {Self : Type _} {T : Type _} (CanSampleInst : CanSample Self T) (n : Std.Usize)
+  (self : Self) (result : alloc.vec.Vec T) :
+  RustM (ControlFlow (Self × (alloc.vec.Vec T)) ((alloc.vec.Vec T) × Self))
+  := do
+  let i ← alloc.vec.Vec.len result
+  if i < n
+  then
+    let (t, self1) ← CanSampleInst.sample self
+    let result1 ← alloc.vec.Vec.push result t
+    ok (cont (self1, result1))
+  else ok (done (result, self))
+
+-- PATCHED: the loop of the body above.
+@[rust_loop]
+def CanSample.sample_vec.default_loop
+  {Self : Type _} {T : Type _} (CanSampleInst : CanSample Self T) (n : Std.Usize)
+  (self : Self) (result : alloc.vec.Vec T) :
+  RustM ((alloc.vec.Vec T) × Self)
+  := do
+  loop
+    (fun (self1, result1) => CanSample.sample_vec.default_loop.body CanSampleInst n self1 result1)
+    (self, result)
+
