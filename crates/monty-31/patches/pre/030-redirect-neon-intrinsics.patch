diff --git a/monty-31/src/aarch64_neon/packing.rs b/monty-31/src/aarch64_neon/packing.rs
--- a/monty-31/src/aarch64_neon/packing.rs
+++ b/monty-31/src/aarch64_neon/packing.rs
@@ -1,6 +1,14 @@
 use alloc::vec::Vec;
+// PATCHED: under hax's Lean backend, the lane-array models of the intrinsics.
+#[cfg(not(hax_backend_lean))]
 use core::arch::aarch64::{self, int32x4_t, uint32x4_t};
+#[cfg(hax_backend_lean)]
+use p3_arch_shims::aarch64::{self, int32x4_t, uint32x4_t};
+// PATCHED: only the `asm!` barrier uses it, which the cfg replaces.
+#[cfg(not(hax_backend_lean))]
 use core::arch::asm;
+// PATCHED: only the `asm!` barrier uses it, which the cfg replaces.
+#[cfg(not(hax_backend_lean))]
 use core::hint::unreachable_unchecked;
 use core::iter::{Product, Sum};
 use core::mem::transmute;
@@ -367,6 +375,8 @@
 /// Similar to `core::hint::black_box`, it can be used to stop the compiler applying undesirable
 /// "optimizations". Unlike the built-in `black_box`, it does not force the value to be written to
 /// and then read from the stack.
+// PATCHED: under hax's Lean backend, the identity below, since the extractor rejects `asm!`.
+#[cfg(not(hax_backend_lean))]
 #[inline]
 #[must_use]
 fn confuse_compiler(x: uint32x4_t) -> uint32x4_t {
@@ -386,6 +396,15 @@
         }
     }
     y
+}
+
+// PATCHED: the `asm!` barrier's value: its template is a comment, and the check after it tells
+// the compiler that `y == x`. The optimisation it inhibits is not modelled.
+#[cfg(hax_backend_lean)]
+#[inline]
+#[must_use]
+fn confuse_compiler(x: uint32x4_t) -> uint32x4_t {
+    x
 }
 
