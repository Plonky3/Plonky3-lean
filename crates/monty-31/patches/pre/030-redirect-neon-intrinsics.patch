+#[cfg(not(hax_backend_lean))]
 use core::arch::aarch64::uint32x4_t;
+#[cfg(hax_backend_lean)]
+use p3_arch_shims::aarch64::uint32x4_t;
 
 use p3_monty_31::{
     InternalLayerParametersNeon, mul_2exp_neg_n_neon, mul_2exp_neg_two_adicity_neon,
