+//! PATCHED: extraction roots for hax's Lean backend, compiled only under `cfg(hax_backend_lean)`.
+//!
+//! Aeneas drops a method that no free function calls (Plonky3-lean, docs/extractor-issues.md, 4).
+//! Each function here calls one item and does nothing else, so that the item's own body is extracted.
+//!
+//! The fields stay generic.
+//! The Lean model then quantifies over every implementation of them.
+
+use alloc::vec::Vec;
+
+use p3_field::{ExtensionField, Field};
+
+use crate::point::Point;
+
+pub fn eval_eq<F: Field, EF: ExtensionField<F>>(p: &[F], q: &[EF]) -> EF {
+    Point::<F>::eval_eq(p, q)
+}
+
+pub fn point_new<F>(coords: Vec<F>) -> Point<F> {
+    Point::new(coords)
+}
