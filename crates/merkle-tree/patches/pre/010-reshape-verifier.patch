+
+    /// A digest of two words.
+    type D = [u64; 2];
+
+    /// A deterministic mixing hash over the flattened input stream.
+    #[derive(Clone)]
+    struct Mix;
+
+    fn mix(acc: u64, x: u64) -> u64 {
+        (acc ^ x.wrapping_add(0x9e37_79b9_7f4a_7c15))
+            .wrapping_mul(0xbf58_476d_1ce4_e5b9)
+            .rotate_left(31)
+    }
+
+    impl CryptographicHasher<u64, D> for Mix {
+        fn hash_iter<I: IntoIterator<Item = u64>>(&self, input: I) -> D {
+            let mut a = 1;
+            let mut b = 2;
+            for x in input {
+                a = mix(a, x);
+                b = mix(b, a);
+            }
+            [a, b]
+        }
+    }
+
+    impl<const N: usize> PseudoCompressionFunction<D, N> for Mix {
+        fn compress(&self, input: [D; N]) -> D {
+            self.hash_iter(input.into_iter().flatten())
+        }
+    }
+
+    type Mmcs2 = MerkleTreeMmcs<u64, u64, Mix, Mix, 2, 2>;
+    type Mmcs4 = MerkleTreeMmcs<u64, u64, Mix, Mix, 4, 2>;
+
+    /// A small deterministic stream of words.
+    struct Rng(u64);
+
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 ^= self.0 << 13;
+            self.0 ^= self.0 >> 7;
+            self.0 ^= self.0 << 17;
+            self.0
+        }
+    }
+
+    /// Every height on the ladder of `max`, tallest first.
+    fn ladder(max: usize) -> Vec<usize> {
+        let log = p3_util::log2_ceil_usize(max);
+        let mut out: Vec<usize> = (0..=log).map(|k| ((max - 1) >> k) + 1).collect();
+        out.dedup();
+        out
+    }
+
+    fn show<T: core::fmt::Debug>(r: &T) -> String {
+        format!("{r:?}")
+    }
+
+    /// Compares the reshaped and the shipped verifier on one opening and its mutations.
+    fn compare<const N: usize>(
+        mmcs: &MerkleTreeMmcs<u64, u64, Mix, Mix, N, 2>,
+        commit: &MerkleCap<u64, D>,
+        dims: &[Dimensions],
+        index: usize,
+        rows: &[Vec<u64>],
+        proof: &[D],
+    ) {
+        let proof_vec = proof.to_vec();
+        let shipped =
+            mmcs.verify_batch(commit, dims, index, p3_commit::BatchOpeningRef::new(rows, &proof_vec));
+        let reshaped = super::verify_batch(mmcs, commit, dims, index, rows, proof);
+        assert_eq!(show(&shipped), show(&reshaped), "dims {dims:?} index {index}");
+    }
+
+    fn check_batch<const N: usize>(cap_height: usize, heights: &[usize], widths: &[usize], rng: &mut Rng) {
+        let mmcs = MerkleTreeMmcs::<u64, u64, Mix, Mix, N, 2>::new(Mix, Mix, cap_height);
+        let mats: Vec<RowMajorMatrix<u64>> = heights
+            .iter()
+            .zip(widths)
+            .map(|(&h, &w)| RowMajorMatrix::new((0..h * w).map(|_| rng.next() % 7).collect(), w.max(1)))
+            .collect();
+        // A width-zero matrix cannot be built from values, so widths here are at least one.
+        let dims: Vec<Dimensions> = mats.iter().map(|m| m.dimensions()).collect();
+
+        // Invariant: the schedule helpers agree on every claimed shape.
+        assert_eq!(
+            show(&super::validate_heights(&dims)),
+            show(&crate::mmcs::validate_commit_reachable_heights(dims.iter().map(|d| d.height)))
+        );
+        assert_eq!(
+            show(&super::arity_schedule_and_proof_levels::<N>(cap_height, &dims)),
+            show(&mmcs.arity_schedule_and_proof_levels(&dims))
+        );
+
+        let (commit, data) = mmcs.commit(mats);
+        let max = heights.iter().copied().max().unwrap();
+        for index in 0..max + 2 {
+            let index_open = index.min(max - 1);
+            let (rows, proof) = mmcs.open_batch(index_open, &data).unpack();
+
+            // Fixture state: the honest opening, at the queried index and past the end.
+            compare(&mmcs, &commit, &dims, index, &rows, &proof);
+
+            // Mutation: one sibling flipped, one dropped, one added.
+            if !proof.is_empty() {
+                let mut p = proof.clone();
+                p[0][0] ^= 1;
+                compare(&mmcs, &commit, &dims, index, &rows, &p);
+                compare(&mmcs, &commit, &dims, index, &rows, &proof[1..]);
+            }
+            let mut p = proof.clone();
+            p.push([0, 0]);
+            compare(&mmcs, &commit, &dims, index, &rows, &p);
+
+            // Mutation: one value changed, one row shortened, one row dropped.
+            let mut r = rows.clone();
+            r[0][0] ^= 1;
+            compare(&mmcs, &commit, &dims, index, &r, &proof);
+            let mut r = rows.clone();
+            r.last_mut().unwrap().pop();
+            compare(&mmcs, &commit, &dims, index, &r, &proof);
+            compare(&mmcs, &commit, &dims, index, &rows[1..], &proof);
+
+            // Mutation: the claimed dimensions change.
+            let mut d = dims.clone();
+            d[0].height += 1;
+            compare(&mmcs, &commit, &d, index, &rows, &proof);
+            let mut d = dims.clone();
+            d.reverse();
+            let mut r = rows.clone();
+            r.reverse();
+            compare(&mmcs, &commit, &d, index, &r, &proof);
+
+            // Mutation: a cap with one root too many.
+            let mut roots = commit.roots().to_vec();
+            roots.extend_from_slice(&roots.clone());
+            let doubled = MerkleCap::new(roots);
+            compare(&mmcs, &doubled, &dims, index, &rows, &proof);
+        }
+    }
+
+    #[test]
+    fn reshaped_verifier_matches_on_every_ladder_subset() {
+        let mut rng = Rng(0x1234_5678_9abc_def1);
+        for max in 1..=19 {
+            let ladder = ladder(max);
+            let shorter = &ladder[1..];
+            // Fixture state: the tallest matrix, plus every subset of the shorter rungs.
+            for mask in 0..(1usize << shorter.len()) {
+                let mut heights = vec![max];
+                for (bit, &h) in shorter.iter().enumerate() {
+                    if mask >> bit & 1 == 1 {
+                        heights.push(h);
+                    }
+                }
+                // A second matrix of the tallest height, to exercise a leaf group of two.
+                if mask % 3 == 0 {
+                    heights.push(max);
+                }
+                let widths: Vec<usize> = (0..heights.len()).map(|i| 1 + (i * 5 + max) % 4).collect();
+                for cap_height in [0, 1, 2, 9] {
+                    check_batch::<2>(cap_height, &heights, &widths, &mut rng);
+                    check_batch::<4>(cap_height, &heights, &widths, &mut rng);
+                    // Invariant: shuffled insertion order commits and verifies the same way.
+                    let mut rev_h = heights.clone();
+                    rev_h.reverse();
+                    let mut rev_w = widths.clone();
+                    rev_w.reverse();
+                    check_batch::<2>(cap_height, &rev_h, &rev_w, &mut rng);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn reshaped_hiding_verifier_matches() {
+        use rand::SeedableRng;
+        use rand::rngs::StdRng;
+
+        type Hiding = crate::MerkleTreeHidingMmcs<u64, u64, Mix, Mix, StdRng, 2, 2, 3>;
+        let mut rng = Rng(77);
+        for heights in [vec![8, 4, 1], vec![5, 3, 3, 1], vec![1], vec![2, 1]] {
+            let hiding = Hiding::new(Mix, Mix, 1, StdRng::seed_from_u64(5));
+            let inner = Mmcs2::new(Mix, Mix, 1);
+            let mats: Vec<RowMajorMatrix<u64>> = heights
+                .iter()
+                .enumerate()
+                .map(|(i, &h)| RowMajorMatrix::new((0..h * (i + 1)).map(|_| rng.next() % 5).collect(), i + 1))
+                .collect();
+            let dims: Vec<Dimensions> = mats.iter().map(|m| m.dimensions()).collect();
+            let (commit, data) = hiding.commit(mats);
+            for index in 0..heights[0] + 1 {
+                let (rows, (salts, siblings)) = hiding.open_batch(index.min(heights[0] - 1), &data).unpack();
+                let run = |rows: &[Vec<u64>], salts: &Vec<Vec<u64>>| {
+                    let proof = (salts.clone(), siblings.clone());
+                    let shipped =
+                        hiding.verify_batch(&commit, &dims, index, p3_commit::BatchOpeningRef::new(rows, &proof));
+                    let reshaped = super::hiding_verify_batch::<u64, u64, u64, u64, Mix, Mix, 2, 2, 3>(
+                        &inner, &commit, &dims, index, rows, salts, &siblings,
+                    );
+                    assert_eq!(show(&shipped), show(&reshaped), "heights {heights:?} index {index}");
+                };
+                // Fixture state: the honest opening.
+                run(&rows, &salts);
+                // Mutation: a salt changed, a salt shortened, a salt moved into the row.
+                let mut s2 = salts.clone();
+                s2[0][0] ^= 1;
+                run(&rows, &s2);
+                let mut s3 = salts.clone();
+                let moved = s3[0].pop().unwrap();
+                let mut r3 = rows.clone();
+                r3[0].push(moved);
+                run(&r3, &s3);
+                run(&rows, &s3);
+                // Mutation: one salt missing.
+                run(&rows, &salts[1..].to_vec());
+            }
+        }
+    }
+
+    #[test]
+    fn reshaped_helpers_match_on_claimed_shapes() {
+        // Fixture state: every claimed height pair and triple up to 12, valid or not, including zero.
+        for a in 0..=12usize {
+            for b in 0..=12usize {
+                for c in [0usize, 1, 3, 12] {
+                    let dims: Vec<Dimensions> = [a, b, c]
+                        .iter()
+                        .map(|&height| Dimensions { width: 1, height })
+                        .collect();
+                    assert_eq!(
+                        show(&super::validate_heights(&dims)),
+                        show(&crate::mmcs::validate_commit_reachable_heights(
+                            dims.iter().map(|d| d.height)
+                        ))
+                    );
+                    let mmcs2 = Mmcs2::new(Mix, Mix, 1);
+                    let mmcs4 = Mmcs4::new(Mix, Mix, 0);
+                    assert_eq!(
+                        show(&super::arity_schedule_and_proof_levels::<2>(1, &dims)),
+                        show(&mmcs2.arity_schedule_and_proof_levels(&dims))
+                    );
+                    assert_eq!(
+                        show(&super::arity_schedule_and_proof_levels::<4>(0, &dims)),
+                        show(&mmcs4.arity_schedule_and_proof_levels(&dims))
+                    );
+                }
+            }
+        }
+        // Mutation: the empty batch.
+        assert_eq!(show(&super::validate_heights(&[])), show(&crate::mmcs::validate_commit_reachable_heights([])));
+        let rows: Vec<Vec<u64>> = vec![vec![1, 2], vec![]];
+        let dims = [Dimensions { width: 2, height: 4 }, Dimensions { width: 1, height: 2 }];
+        assert_eq!(show(&super::check_widths(&dims, &rows)), show(&crate::mmcs::check_widths(&dims, &rows)));
+        assert_eq!(show(&super::check_widths(&dims, &rows[..1])), show(&crate::mmcs::check_widths(&dims, &rows[..1])));
+    }
+}
