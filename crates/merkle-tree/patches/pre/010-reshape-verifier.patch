+//! PATCHED: verifier bodies in a shape hax's Lean backend translates.
+//!
+//! Aeneas stops on the iterator adapters of the shipped verifier (Plonky3-lean, docs/extractor-issues.md, 30).
+//!
+//! Each body here walks the matrices with an index into a sorted list instead.
+//!
+//! It makes the same checks, hash calls and compression calls, in the same order, as the shipped one.
+
+use alloc::vec::Vec;
+
+use p3_matrix::Dimensions;
+use p3_symmetric::{CryptographicHasher, MerkleCap, PseudoCompressionFunction};
+use p3_util::log2_ceil_usize;
+
+use crate::merkle_tree::padded_len;
+use crate::MerkleTreeError::{
+    CapMismatch, EmptyBatch, IncompatibleHeights, IndexOutOfBounds, WrongBatchSize, WrongCapSize,
+    WrongHeight, WrongWidth,
+};
+use crate::{MerkleTreeError, MerkleTreeMmcs};
+
+/// The rows of the matrices `order[start..end]`, in that order, as slices.
+pub(crate) struct Rows<'a, F> {
+    opened_values: &'a [Vec<F>],
+    order: &'a [usize],
+    pos: usize,
+    end: usize,
+}
+
+impl<'a, F> Iterator for Rows<'a, F> {
+    type Item = &'a [F];
+
+    fn next(&mut self) -> Option<&'a [F]> {
+        if self.pos < self.end {
+            let row = self.opened_values[self.order[self.pos]].as_slice();
+            self.pos += 1;
+            Some(row)
+        } else {
+            None
+        }
+    }
+}
+
+/// The matrix indices, tallest first, with ties in input order.
+pub(crate) fn tallest_first(dimensions: &[Dimensions]) -> Vec<usize> {
+    let mut order: Vec<usize> = Vec::new();
+    let mut i = 0;
+    while i < dimensions.len() {
+        // Every entry at least as tall stays in front, so equal heights keep their input order.
+        let height = dimensions[i].height;
+        let mut j = 0;
+        while j < order.len() && dimensions[order[j]].height >= height {
+            j += 1;
+        }
+        order.insert(j, i);
+        i += 1;
+    }
+    order
+}
+
+/// What the height check returns on these dimensions.
+pub(crate) fn validate_heights(dimensions: &[Dimensions]) -> Result<usize, MerkleTreeError> {
+    // The tallest height, or zero for an empty batch.
+    let mut max_height = 0;
+    let mut i = 0;
+    while i < dimensions.len() {
+        if dimensions[i].height > max_height {
+            max_height = dimensions[i].height;
+        }
+        i += 1;
+    }
+    if max_height == 0 {
+        return Err(EmptyBatch);
+    }
+    let log_max_height = log2_ceil_usize(max_height);
+
+    // Each height must be the one rung of the ladder its power of two names.
+    let mut i = 0;
+    while i < dimensions.len() {
+        let height = dimensions[i].height;
+        let bits_reduced = log_max_height - log2_ceil_usize(height);
+        let expected_height = ((max_height - 1) >> bits_reduced) + 1;
+        if height != expected_height {
+            return Err(IncompatibleHeights {
+                height,
+                max_height,
+                expected_height,
+                bits_reduced,
+            });
+        }
+        i += 1;
+    }
+    Ok(max_height)
+}
+
+/// What the width check returns on these rows.
+pub(crate) fn check_widths<T>(
+    dimensions: &[Dimensions],
+    opened_values: &[Vec<T>],
+) -> Result<(), MerkleTreeError> {
+    if opened_values.len() != dimensions.len() {
+        return Err(WrongBatchSize {
+            expected: dimensions.len(),
+            got: opened_values.len(),
+        });
+    }
+    let mut matrix = 0;
+    while matrix < dimensions.len() {
+        let width = opened_values[matrix].len();
+        if width != dimensions[matrix].width {
+            return Err(WrongWidth {
+                matrix,
+                expected: dimensions[matrix].width,
+                got: width,
+            });
+        }
+        matrix += 1;
+    }
+    Ok(())
+}
+
+/// What the arity choice returns, with the remaining matrices `order[from..]`.
+pub(crate) fn select_arity_step<const N: usize>(
+    curr_height_padded: usize,
+    leaf_height_npt: usize,
+    dimensions: &[Dimensions],
+    order: &[usize],
+    from: usize,
+) -> usize {
+    if curr_height_padded < N {
+        return 2;
+    }
+    let n_ary_target = (curr_height_padded / N).next_power_of_two();
+
+    // A matrix that lands between here and the next N-ary layer forces a binary step.
+    let mut k = from;
+    while k < order.len() {
+        let npt = dimensions[order[k]].height.next_power_of_two();
+        if npt != leaf_height_npt && npt > n_ary_target {
+            return 2;
+        }
+        k += 1;
+    }
+    N
+}
+
+/// What the schedule walk returns: the full arity schedule and how many of its levels a proof walks.
+pub(crate) fn arity_schedule_and_proof_levels<const N: usize>(
+    cap_height: usize,
+    dimensions: &[Dimensions],
+) -> Result<(Vec<usize>, usize), MerkleTreeError> {
+    let max_height = validate_heights(dimensions)?;
+    let order = tallest_first(dimensions);
+    let mut curr_height_padded = padded_len(max_height, N);
+    let leaf_height_npt = max_height.next_power_of_two();
+
+    // Skip the matrices hashed into the leaf layer.
+    let mut pos = 0;
+    while pos < order.len() && dimensions[order[pos]].height.next_power_of_two() == leaf_height_npt
+    {
+        pos += 1;
+    }
+
+    let mut schedule = Vec::new();
+    while curr_height_padded > 1 {
+        let step = select_arity_step::<N>(
+            curr_height_padded,
+            leaf_height_npt,
+            dimensions,
+            &order,
+            pos,
+        );
+        schedule.push(step);
+        let logical_next = curr_height_padded / step;
+        curr_height_padded = padded_len(logical_next, N);
+
+        // Consume the matrices injected at the next layer.
+        let logical_next_npt = logical_next.next_power_of_two();
+        if pos < order.len() {
+            let next_height = dimensions[order[pos]].height;
+            if next_height.next_power_of_two() == logical_next_npt {
+                while pos < order.len() && dimensions[order[pos]].height == next_height {
+                    pos += 1;
+                }
+            }
+        }
+    }
+
+    let total_levels = schedule.len();
+    let effective_cap_height = if cap_height < total_levels {
+        cap_height
+    } else {
+        total_levels
+    };
+    Ok((schedule, total_levels - effective_cap_height))
+}
+
+/// What the cap-size check returns.
+pub(crate) fn check_cap_size<F, D, const N: usize>(
+    cap_height: usize,
+    commit: &MerkleCap<F, D>,
+    dimensions: &[Dimensions],
+) -> Result<(), MerkleTreeError> {
+    let (schedule, proof_levels) = arity_schedule_and_proof_levels::<N>(cap_height, dimensions)?;
+    let mut expected = 1;
+    let mut l = proof_levels;
+    while l < schedule.len() {
+        expected *= schedule[l];
+        l += 1;
+    }
+    if commit.num_roots() != expected {
+        return Err(WrongCapSize {
+            expected,
+            got: commit.num_roots(),
+        });
+    }
+    Ok(())
+}
+
+/// What the single-index verifier returns.
+pub(crate) fn verify_batch<P, PW, F, W, H, C, const N: usize, const DIGEST_ELEMS: usize>(
+    mmcs: &MerkleTreeMmcs<P, PW, H, C, N, DIGEST_ELEMS>,
+    commit: &MerkleCap<F, [W; DIGEST_ELEMS]>,
+    dimensions: &[Dimensions],
+    mut index: usize,
+    opened_values: &[Vec<F>],
+    opening_proof: &[[W; DIGEST_ELEMS]],
+) -> Result<(), MerkleTreeError>
+where
+    F: Clone,
+    W: Copy + Default + PartialEq,
+    H: CryptographicHasher<F, [W; DIGEST_ELEMS]>,
+    C: PseudoCompressionFunction<[W; DIGEST_ELEMS], N>,
+{
+    if dimensions.len() != opened_values.len() {
+        return Err(WrongBatchSize {
+            expected: dimensions.len(),
+            got: opened_values.len(),
+        });
+    }
+    let max_height = validate_heights(dimensions)?;
+
+    check_cap_size::<F, [W; DIGEST_ELEMS], N>(mmcs.cap_height, commit, dimensions)?;
+    let (mut arity_schedule, proof_levels) =
+        arity_schedule_and_proof_levels::<N>(mmcs.cap_height, dimensions)?;
+    arity_schedule.truncate(proof_levels);
+    let mut expected_proof_len = 0;
+    let mut l = 0;
+    while l < arity_schedule.len() {
+        expected_proof_len += arity_schedule[l] - 1;
+        l += 1;
+    }
+    if opening_proof.len() != expected_proof_len {
+        return Err(WrongHeight {
+            expected_proof_len,
+            num_siblings: opening_proof.len(),
+        });
+    }
+
+    check_widths(dimensions, opened_values)?;
+
+    let order = tallest_first(dimensions);
+    let mut curr_height_padded = padded_len(max_height, N);
+
+    if index >= max_height {
+        return Err(IndexOutOfBounds { max_height, index });
+    }
+
+    // Hash the rows of the matrices in the leaf layer.
+    let leaf_height_npt = max_height.next_power_of_two();
+    let mut pos = 0;
+    while pos < order.len() && dimensions[order[pos]].height.next_power_of_two() == leaf_height_npt
+    {
+        pos += 1;
+    }
+    let mut digest: [W; DIGEST_ELEMS] = mmcs.hash.hash_iter_slices(Rows {
+        opened_values,
+        order: &order,
+        pos: 0,
+        end: pos,
+    });
+
+    let default_digest = [W::default(); DIGEST_ELEMS];
+    let mut proof_pos: usize = 0;
+
+    let mut level = 0;
+    while level < arity_schedule.len() {
+        let step = arity_schedule[level];
+        let num_siblings = step - 1;
+
+        // The path's own digest at its position, the siblings in order elsewhere, padding past the arity.
+        let pos_in_group = index % step;
+        let mut inputs = [default_digest; N];
+        let mut sibling_idx = 0;
+        let mut k = 0;
+        while k < N {
+            if k < step {
+                if k == pos_in_group {
+                    inputs[k] = digest;
+                } else {
+                    inputs[k] = opening_proof[proof_pos + sibling_idx];
+                    sibling_idx += 1;
+                }
+            }
+            k += 1;
+        }
+        proof_pos += num_siblings;
+
+        digest = mmcs.compress.compress(inputs);
+        index /= step;
+        let logical_next = curr_height_padded / step;
+        curr_height_padded = padded_len(logical_next, N);
+
+        // Mix in the rows of the matrices injected at the next layer.
+        let logical_next_npt = logical_next.next_power_of_two();
+        if pos < order.len() {
+            let next_height = dimensions[order[pos]].height;
+            if next_height.next_power_of_two() == logical_next_npt {
+                let start = pos;
+                while pos < order.len() && dimensions[order[pos]].height == next_height {
+                    pos += 1;
+                }
+                let next_height_openings_digest: [W; DIGEST_ELEMS] =
+                    mmcs.hash.hash_iter_slices(Rows {
+                        opened_values,
+                        order: &order,
+                        pos: start,
+                        end: pos,
+                    });
+
+                let mut inject_inputs = [default_digest; N];
+                inject_inputs[0] = digest;
+                inject_inputs[1] = next_height_openings_digest;
+                digest = mmcs.compress.compress(inject_inputs);
+            }
+        }
+        level += 1;
+    }
+
+    // The index now points into the cap layer.
+    let cap_index = index;
+    if cap_index < commit.num_roots() && commit[cap_index] == digest {
+        Ok(())
+    } else {
+        Err(CapMismatch)
+    }
+}
+
+/// What the hiding verifier returns, with `inner` the tree it salts.
+pub(crate) fn hiding_verify_batch<
+    P,
+    PW,
+    F,
+    W,
+    H,
+    C,
+    const N: usize,
+    const DIGEST_ELEMS: usize,
+    const SALT_ELEMS: usize,
+>(
+    inner: &MerkleTreeMmcs<P, PW, H, C, N, DIGEST_ELEMS>,
+    commit: &MerkleCap<F, [W; DIGEST_ELEMS]>,
+    dimensions: &[Dimensions],
+    index: usize,
+    opened_values: &[Vec<F>],
+    salts: &[Vec<F>],
+    siblings: &[[W; DIGEST_ELEMS]],
+) -> Result<(), MerkleTreeError>
+where
+    F: Clone,
+    W: Copy + Default + PartialEq,
+    H: CryptographicHasher<F, [W; DIGEST_ELEMS]>,
+    C: PseudoCompressionFunction<[W; DIGEST_ELEMS], N>,
+{
+    check_widths(dimensions, opened_values)?;
+
+    if opened_values.len() != salts.len() {
+        return Err(WrongBatchSize {
+            expected: opened_values.len(),
+            got: salts.len(),
+        });
+    }
+
+    // Each row followed by its salt.
+    let mut opened_salted_values: Vec<Vec<F>> = Vec::new();
+    let mut i = 0;
+    while i < opened_values.len() {
+        let mut row: Vec<F> = Vec::new();
+        let mut j = 0;
+        while j < opened_values[i].len() {
+            row.push(opened_values[i][j].clone());
+            j += 1;
+        }
+        let mut j = 0;
+        while j < salts[i].len() {
+            row.push(salts[i][j].clone());
+            j += 1;
+        }
+        opened_salted_values.push(row);
+        i += 1;
+    }
+
+    // Each width widened by the salt.
+    let mut salted_dimensions: Vec<Dimensions> = Vec::new();
+    let mut i = 0;
+    while i < dimensions.len() {
+        salted_dimensions.push(Dimensions {
+            width: dimensions[i].width + SALT_ELEMS,
+            height: dimensions[i].height,
+        });
+        i += 1;
+    }
+
+    verify_batch(
+        inner,
+        commit,
+        &salted_dimensions,
+        index,
+        &opened_salted_values,
+        siblings,
+    )
+}
