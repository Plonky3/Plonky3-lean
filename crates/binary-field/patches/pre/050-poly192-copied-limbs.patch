# Patch:        050-poly192-copied-limbs
# Phase:        pre
# Target:       binary-field/src/poly192.rs
# Hunks:        5
# Class:        equiv-rewrite
# Gap:          docs/extractor-issues.md 12: aeneas does not support
#               dereferencing a raw pointer, and `Poly192::limbs` reborrows
#               `[Poly64; 3]` as `&[u64; 3]` through one.
# Cost:         none in a normal build: the copy is compiled but unused there.
#               In the extracted variant, `Mul`, `Mul<Poly64>` and `square`
#               read the coordinates through `limbs_owned`, which copies each
#               coordinate's bits, instead of borrowing them in place.
# Upstreamable: no: the borrow lets vector kernels load in place.
# Drop when:    aeneas models the raw-pointer reborrow.
# Test:         test p3-binary-field --lib pre_patch_050
# Mutation:     `limbs_owned` swaps the first two coordinates, so it disagrees
#               with `limbs` and the differential test fails.
#
# `limbs` reinterprets `&[Poly64; 3]` as `&[u64; 3]`, which is sound because
# `Poly64` is `repr(transparent)` over `u64`.
# aeneas stops at the raw-pointer dereference, so `Poly192`'s products could not
# be extracted.
# `limbs_owned` copies the three coordinates' bits, compiled in every build.
# Under cfg(hax_backend_lean) the two products and `square` pass a reference to
# that copy.
# The differential test compares it with `limbs` on edge values and 10000
# pseudo-random elements.
#
--- a/binary-field/src/poly192.rs
+++ b/binary-field/src/poly192.rs
@@ -107,6 +107,15 @@
         unsafe { &*ptr::from_ref(&self.0).cast() }
     }
 
+    // PATCHED: the coordinates as raw bit patterns, copied rather than borrowed in
+    // place, compiled in every build. aeneas does not model the raw-pointer cast in
+    // `limbs`; under cfg(hax_backend_lean) the products read this copy instead.
+    #[allow(dead_code)]
+    #[inline]
+    const fn limbs_owned(&self) -> [u64; DEGREE] {
+        [self.0[0].to_bits(), self.0[1].to_bits(), self.0[2].to_bits()]
+    }
+
     /// The element with the given raw coordinates.
     #[inline]
     const fn from_limbs([a0, a1, a2]: [u64; DEGREE]) -> Self {
@@ -202,7 +211,12 @@
     #[inline]
     fn mul(self, rhs: Self) -> Self {
         // Six carryless products, the fold of y, and one reduction per coordinate.
-        Self::from_limbs(clmul::poly_mul_192(self.limbs(), rhs.limbs()))
+        #[cfg(not(hax_backend_lean))]
+        let (a, b) = (self.limbs(), rhs.limbs());
+        // PATCHED: the selection, only under hax's Lean backend.
+        #[cfg(hax_backend_lean)]
+        let (a, b) = (&self.limbs_owned(), &rhs.limbs_owned());
+        Self::from_limbs(clmul::poly_mul_192(a, b))
     }
 }
 
@@ -213,7 +227,12 @@
     #[inline]
     fn mul(self, rhs: Poly64) -> Self {
         // One carryless product and one reduction per coordinate.
-        Self::from_limbs(clmul::poly_mul_192_by_64(self.limbs(), rhs.as_bits()))
+        #[cfg(not(hax_backend_lean))]
+        let a = self.limbs();
+        // PATCHED: the selection, only under hax's Lean backend.
+        #[cfg(hax_backend_lean)]
+        let a = &self.limbs_owned();
+        Self::from_limbs(clmul::poly_mul_192_by_64(a, rhs.as_bits()))
     }
 }
 
@@ -258,7 +277,12 @@
     #[inline]
     fn square(&self) -> Self {
         // Three coordinate squares, the fold of y^4, then three reductions.
-        Self::from_limbs(clmul::poly_square_192(self.limbs()))
+        #[cfg(not(hax_backend_lean))]
+        let a = self.limbs();
+        // PATCHED: the selection, only under hax's Lean backend.
+        #[cfg(hax_backend_lean)]
+        let a = &self.limbs_owned();
+        Self::from_limbs(clmul::poly_square_192(a))
     }
 
     /// `x (x - 1) = x^2 + x` in characteristic 2, and squaring is the cheaper product.
@@ -815,3 +839,30 @@
         }
     }
 }
+
+// PATCHED: the differential test of the copied coordinates against the borrowed
+// ones, in the normal build.
+#[cfg(test)]
+mod pre_patch_050 {
+    use super::*;
+
+    #[test]
+    fn copied_limbs_agree_with_borrowed_limbs() {
+        let mut x = 0x9e37_79b9_7f4a_7c15_u64;
+        let mut next = || {
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            x
+        };
+        let edges = [0, 1, u64::MAX, 1 << 63];
+        for &e in &edges {
+            let a = Poly192::from_limbs([e, !e, e.rotate_left(17)]);
+            assert_eq!(a.limbs_owned(), *a.limbs());
+        }
+        for _ in 0..10_000 {
+            let a = Poly192::from_limbs([next(), next(), next()]);
+            assert_eq!(a.limbs_owned(), *a.limbs());
+        }
+    }
+}
