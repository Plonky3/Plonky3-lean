+//! PATCHED: added by Plonky3-lean pre-patch 020 (`cfg-hide-ghash-bit-plane-expansion`).
+//!
+//! The patch removes `Ghash128`'s override of `Field::prepare_bit_plane_expansion` from the extracted variant only.
+//!
+//! In a normal build the override must still be there.
+//!
+//! It is the one that returns a correct expansion on targets with the required features.
+
+use p3_binary_field::Ghash128;
+use p3_field::{Field, PrimeCharacteristicRing};
+
+const HAS_EXPANSION: bool = cfg!(all(
+    target_arch = "x86_64",
+    target_feature = "gfni",
+    target_feature = "avx512f",
+    target_feature = "avx512bw",
+    target_feature = "avx512vbmi"
+));
+
+#[test]
+fn the_override_is_present_in_a_normal_build() {
+    let weights: [Ghash128; 64] = core::array::from_fn(|i| Ghash128::from_u64(i as u64 + 1));
+    let expansion = Ghash128::prepare_bit_plane_expansion(&weights);
+    assert_eq!(expansion.is_some(), HAS_EXPANSION);
+    if let Some(expand) = expansion {
+        // Lane 0 of the word for corner 5 is set, so lane 0 sums weight 5 alone.
+        let mut words = [0u64; 64];
+        words[5] = 1;
+        let mut output = Vec::new();
+        expand(&words, &mut output);
+        assert_eq!(output[0], weights[5]);
+    }
+}
