+// PATCHED: the differential test of the inherent copies against the `TowerLevel`
+// methods, in the normal build.
+#[cfg(test)]
+mod pre_patch_040 {
+    use super::*;
+
+    /// A fixed sequence of 64-bit words, so the test needs no extra dependency.
+    fn words(n: usize) -> impl Iterator<Item = u64> {
+        let mut x = 0x9e37_79b9_7f4a_7c15_u64;
+        (0..n).map(move |_| {
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            x
+        })
+    }
+
+    macro_rules! agree {
+        ($t:ty, $repr:ty, $values:expr) => {
+            for r in $values {
+                let r = r as $repr;
+                assert_eq!(<$t>::raw_from_repr(r), <$t as TowerLevel>::from_repr(r));
+                let x = <$t as TowerLevel>::from_repr(r);
+                assert_eq!(x.raw_to_repr(), <$t as TowerLevel>::to_repr(x));
+                assert_eq!(x.raw_mul_alpha(), <$t as TowerLevel>::mul_alpha(x));
+            }
+        };
+    }
+
+    #[test]
+    fn copies_agree_with_the_trait_methods() {
+        agree!(Gf2, u8, 0..=255u32);
+        agree!(BinaryField2, u8, 0..=255u32);
+        agree!(BinaryField4, u8, 0..=255u32);
+        agree!(BinaryField8, u8, 0..=255u32);
+        agree!(BinaryField16, u16, 0..=65535u32);
+        let edges = [0u64, 1, 2, u64::MAX, u64::MAX - 1, 1 << 63, 1 << 31];
+        agree!(BinaryField32, u32, edges.into_iter().chain(words(10_000)));
+        agree!(BinaryField64, u64, edges.into_iter().chain(words(10_000)));
+        let random: alloc::vec::Vec<u64> = words(20_000).collect();
+        let wide = edges
+            .into_iter()
+            .map(|e| (e as u128) << 64 | e as u128)
+            .chain(random.chunks(2).map(|c| (c[0] as u128) << 64 | c[1] as u128));
+        agree!(BinaryField128, u128, wide);
+    }
+}
