+//! PATCHED: extraction roots for hax's Lean backend, compiled only under
+//! `cfg(hax_backend_lean)`.
+//!
+//! Charon translates the methods of the field types but leaves every method that no
+//! free function calls out of the declaration order aeneas reads, so aeneas drops
+//! them without a diagnostic (Plonky3-lean, docs/extractor-issues.md, 4).
+//! Each function here calls exactly one such method and does nothing else, so that
+//! the method's own body is extracted.
+
+use crate::{
+    BinaryField2, BinaryField4, BinaryField8, BinaryField16, BinaryField32, BinaryField64,
+    BinaryField128, Gf2, Ghash128, Poly64, Poly192,
+};
+
+pub fn gf2_add(a: Gf2, b: Gf2) -> Gf2 {
+    a + b
+}
+
+pub fn gf2_sub(a: Gf2, b: Gf2) -> Gf2 {
+    a - b
+}
+
+pub fn gf2_neg(a: Gf2) -> Gf2 {
+    -a
+}
+
+pub fn gf2_mul(a: Gf2, b: Gf2) -> Gf2 {
