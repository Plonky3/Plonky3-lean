+//! PATCHED: extraction roots for the methods the field types implement, compiled only
+//! under `cfg(hax_backend_lean)`.
+//!
+//! As in `hax_roots`, each function calls one method on a concrete type, so that charon
+//! lists the method and aeneas emits its body (Plonky3-lean, docs/extractor-issues.md, 4).
+//! Only methods this crate implements are rooted: a default method of p3-field's traits
+//! takes the trait's dictionary, which aeneas cannot model (docs/extractor-issues.md, 9).
+
+#![allow(unused_imports)]
+
+use p3_field::extension::HasFrobenius;
+use p3_field::integers::QuotientMap;
+use p3_field::{ExtensionField, Field, PrimeCharacteristicRing, PrimeField32, PrimeField64};
+
+use crate::tower::TowerLevel;
+use crate::{
+    BinaryField2, BinaryField4, BinaryField8, BinaryField16, BinaryField32, BinaryField64,
+    BinaryField128, Gf2, Ghash128, Poly64, Poly192,
+};
+
+/// Methods every field type implements itself.
+macro_rules! field_api {
+    ($t:ty) => {
+        pub fn square(a: $t) -> $t {
+            a.square()
+        }
+
+        pub fn try_inverse(a: $t) -> Option<$t> {
+            a.try_inverse()
+        }
+
+        pub fn try_sqrt(a: $t) -> Option<$t> {
+            a.try_sqrt()
+        }
+
+        pub fn from_prime_subfield(f: Gf2) -> $t {
+            <$t>::from_prime_subfield(f)
+        }
+
+        pub fn interpolation_node(i: usize) -> $t {
+            <$t>::interpolation_node(i)
+        }
+
+        pub fn bits() -> usize {
+            <$t>::bits()
+        }
+
+        pub fn div(a: $t, b: $t) -> $t {
+            a / b
+        }
+
+        pub fn div_assign(mut a: $t, b: $t) -> $t {
+            a /= b;
+            a
+        }
+
+        pub fn add_assign(mut a: $t, b: $t) -> $t {
+            a += b;
+            a
+        }
+
+        pub fn sub_assign(mut a: $t, b: $t) -> $t {
+            a -= b;
+            a
+        }
+
+        pub fn mul_assign(mut a: $t, b: $t) -> $t {
+            a *= b;
+            a
+        }
+
+        pub fn eq(a: $t, b: $t) -> bool {
+            a == b
+        }
+    };
+}
+
+pub mod gf2 {
+    use super::*;
+
+    field_api!(Gf2);
+
+    pub fn from_bool(b: bool) -> Gf2 {
+        Gf2::from_bool(b)
+    }
+
+    pub fn double(a: Gf2) -> Gf2 {
+        a.double()
+    }
+
+    pub fn halve(a: Gf2) -> Gf2 {
+        a.halve()
+    }
+
+    pub fn xor(a: Gf2, b: Gf2) -> Gf2 {
+        a.xor(&b)
+    }
+
+    pub fn mul_2exp_u64(a: Gf2, e: u64) -> Gf2 {
+        a.mul_2exp_u64(e)
+    }
+
+    pub fn div_2exp_u64(a: Gf2, e: u64) -> Gf2 {
+        a.div_2exp_u64(e)
+    }
+
+    pub fn as_canonical_u64(a: Gf2) -> u64 {
+        a.as_canonical_u64()
+    }
+
+    pub fn as_canonical_u32(a: Gf2) -> u32 {
+        a.as_canonical_u32()
+    }
+
+    pub fn from_int_u8(x: u8) -> Gf2 {
+        <Gf2 as QuotientMap<u8>>::from_int(x)
+    }
+
+    pub fn from_canonical_checked_u8(x: u8) -> Option<Gf2> {
+        <Gf2 as QuotientMap<u8>>::from_canonical_checked(x)
+    }
+
+    pub fn from_int_i8(x: i8) -> Gf2 {
+        <Gf2 as QuotientMap<i8>>::from_int(x)
+    }
+
+    pub fn from_canonical_checked_i8(x: i8) -> Option<Gf2> {
+        <Gf2 as QuotientMap<i8>>::from_canonical_checked(x)
+    }
+
+    pub fn from_le_bytes(bytes: [u8; 1]) -> Gf2 {
+        Gf2::from_le_bytes(bytes)
+    }
+
+    pub fn cantor_basis(i: usize) -> Gf2 {
+        <Gf2 as TowerLevel>::cantor_basis(i)
+    }
+}
+
+/// The tower levels: `field_api` and the level's own overrides.
+macro_rules! tower_api {
+    ($module:ident, $t:ty, $bytes:expr) => {
+        pub mod $module {
+            use super::*;
+
+            field_api!($t);
+
+            pub fn from_bool(b: bool) -> $t {
+                <$t>::from_bool(b)
+            }
+
+            pub fn exp_power_of_2(a: $t, k: usize) -> $t {
+                a.exp_power_of_2(k)
+            }
+
+            pub fn dot_product_4(u: &[$t; 4], v: &[$t; 4]) -> $t {
+                <$t>::dot_product(u, v)
+            }
+
+            pub fn bool_check(a: $t) -> $t {
+                a.bool_check()
+            }
+
+            pub fn reference_mul(a: $t, b: $t) -> $t {
+                a.reference_mul(b)
+            }
+
+            pub fn from_le_bytes(bytes: [u8; $bytes]) -> $t {
+                <$t>::from_le_bytes(bytes)
+            }
+
+            pub fn cantor_basis(i: usize) -> $t {
+                <$t as TowerLevel>::cantor_basis(i)
+            }
+        }
+    };
+}
+
+tower_api!(bf2, BinaryField2, 1);
+tower_api!(bf4, BinaryField4, 1);
+tower_api!(bf8, BinaryField8, 1);
+tower_api!(bf16, BinaryField16, 2);
+tower_api!(bf32, BinaryField32, 4);
+tower_api!(bf64, BinaryField64, 8);
+tower_api!(bf128, BinaryField128, 16);
+
+pub mod poly64 {
+    use super::*;
+
+    field_api!(Poly64);
+
+    pub fn from_bool(b: bool) -> Poly64 {
+        Poly64::from_bool(b)
+    }
+
+    pub fn dot_product_4(u: &[Poly64; 4], v: &[Poly64; 4]) -> Poly64 {
+        Poly64::dot_product(u, v)
+    }
+
+    pub fn invert_or_zero(a: Poly64) -> Poly64 {
+        a.invert_or_zero()
+    }
+
+    pub fn new(bits: u64) -> Poly64 {
+        Poly64::new(bits)
+    }
+
+    pub fn to_bits(a: Poly64) -> u64 {
+        a.to_bits()
+    }
+
+    pub fn from_le_bytes(bytes: [u8; 8]) -> Poly64 {
+        Poly64::from_le_bytes(bytes)
+    }
+
+    pub fn cantor_basis(i: usize) -> Poly64 {
+        <Poly64 as TowerLevel>::cantor_basis(i)
+    }
+
+    pub fn from_tower(a: BinaryField64) -> Poly64 {
+        Poly64::from(a)
+    }
+
+    pub fn to_tower(a: Poly64) -> BinaryField64 {
+        BinaryField64::from(a)
+    }
+}
+
+pub mod poly192 {
+    use super::*;
+
+    field_api!(Poly192);
+
+    pub fn bool_check(a: Poly192) -> Poly192 {
+        a.bool_check()
+    }
+
+    pub fn is_in_basefield(a: Poly192) -> bool {
+        <Poly192 as ExtensionField<Poly64>>::is_in_basefield(&a)
+    }
+
+    pub fn as_base(a: Poly192) -> Option<Poly64> {
+        <Poly192 as ExtensionField<Poly64>>::as_base(&a)
+    }
+
+    pub fn frobenius(a: Poly192) -> Poly192 {
+        <Poly192 as HasFrobenius<Poly64>>::frobenius(&a)
+    }
+
+    pub fn repeated_frobenius(a: Poly192, count: usize) -> Poly192 {
+        <Poly192 as HasFrobenius<Poly64>>::repeated_frobenius(&a, count)
+    }
+
+    pub fn invert_or_zero(a: Poly192) -> Poly192 {
+        a.invert_or_zero()
+    }
+
+    pub fn composed_mul(a: Poly192, b: Poly192) -> Poly192 {
+        a.composed_mul(b)
+    }
+
+    pub fn new(coefficients: [Poly64; 3]) -> Poly192 {
+        Poly192::new(coefficients)
+    }
+
+    pub fn coefficients(a: Poly192) -> [Poly64; 3] {
+        a.coefficients()
+    }
+
+
+
+
+
+    pub fn mul_base(a: Poly192, b: Poly64) -> Poly192 {
+        a * b
+    }
+
+    pub fn from_base(a: Poly64) -> Poly192 {
+        Poly192::from(a)
+    }
+}
