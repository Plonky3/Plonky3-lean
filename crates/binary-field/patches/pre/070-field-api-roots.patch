+pub mod ghash128 {
+    use super::*;
+
+    field_api!(Ghash128);
+
+    pub fn bool_check(a: Ghash128) -> Ghash128 {
+        a.bool_check()
+    }
+
+    pub fn invert_or_zero(a: Ghash128) -> Ghash128 {
+        a.invert_or_zero()
+    }
+
+    pub fn from_le_bytes(bytes: [u8; 16]) -> Ghash128 {
+        Ghash128::from_le_bytes(bytes)
