+}
+
+/// An upper tower level as an extension of a lower one.
+macro_rules! extension_api {
+    ($module:ident, $upper:ty, $lower:ty) => {
+        pub mod $module {
+            use super::*;
+
+            pub fn mul_base(a: $upper, b: $lower) -> $upper {
+                a * b
+            }
+
+            pub fn base_mul(a: $lower, b: $upper) -> $upper {
+                a * b
+            }
+
+            pub fn from_base(a: $lower) -> $upper {
+                <$upper>::from(a)
+            }
+
+            pub fn is_in_basefield(a: $upper) -> bool {
+                <$upper as ExtensionField<$lower>>::is_in_basefield(&a)
+            }
+
+            pub fn as_base(a: $upper) -> Option<$lower> {
+                <$upper as ExtensionField<$lower>>::as_base(&a)
+            }
+
+            pub fn frobenius(a: $upper) -> $upper {
+                <$upper as HasFrobenius<$lower>>::frobenius(&a)
+            }
+
+            pub fn repeated_frobenius(a: $upper, count: usize) -> $upper {
+                <$upper as HasFrobenius<$lower>>::repeated_frobenius(&a, count)
+            }
+        }
+    };
+}
+
+extension_api!(bf16_over_bf8, BinaryField16, BinaryField8);
+extension_api!(bf32_over_bf8, BinaryField32, BinaryField8);
