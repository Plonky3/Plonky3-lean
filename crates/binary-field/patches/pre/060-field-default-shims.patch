+//! PATCHED: copies of three `Field` default methods for every field type of this crate,
+//! and, only under hax's Lean backend, inherent methods of the same names that call them.
+//!
+//! Called as defaults, `inverse`, `is_zero` and `is_one` take the type's whole `Field`
+//! dictionary, which aeneas cannot model (Plonky3-lean, docs/extractor-issues.md, 9). An
+//! inherent method shadows the trait method at every call site on a concrete type,
+//! including the `Div` impls `impl_div_methods!` expands here, so under the cfg those call
+//! sites reach these copies instead.
+
+use p3_field::{Field, PrimeCharacteristicRing};
+
+use crate::{
+    BinaryField2, BinaryField4, BinaryField8, BinaryField16, BinaryField32, BinaryField64,
+    BinaryField128, Gf2, Ghash128, Poly64, Poly192, Rijndael8b,
+};
+
+macro_rules! field_defaults {
+    ($($t:ty),* $(,)?) => {$(
+        impl $t {
+            /// The body of `Field::inverse`, compiled in every build.
+            #[allow(dead_code)]
+            #[inline]
+            pub(crate) fn raw_inverse(&self) -> Self {
+                self.try_inverse().expect("Tried to invert zero")
+            }
+
+            /// The body of `Field::is_zero`, compiled in every build.
+            #[allow(dead_code)]
+            #[inline]
+            pub(crate) fn raw_is_zero(&self) -> bool {
+                *self == Self::ZERO
+            }
+
+            /// The body of `Field::is_one`, compiled in every build.
+            #[allow(dead_code)]
+            #[inline]
+            pub(crate) fn raw_is_one(&self) -> bool {
+                *self == Self::ONE
+            }
+
+            // The selection, only under hax's Lean backend.
+            #[cfg(hax_backend_lean)]
+            #[allow(dead_code)]
+            #[inline]
+            pub(crate) fn inverse(&self) -> Self {
+                self.raw_inverse()
+            }
+
+            #[cfg(hax_backend_lean)]
+            #[allow(dead_code)]
+            #[inline]
+            pub(crate) fn is_zero(&self) -> bool {
+                self.raw_is_zero()
+            }
+
+            #[cfg(hax_backend_lean)]
+            #[allow(dead_code)]
+            #[inline]
+            pub(crate) fn is_one(&self) -> bool {
+                self.raw_is_one()
+            }
+        }
+    )*};
+}
+
+field_defaults!(
+    Gf2,
+    BinaryField2,
+    BinaryField4,
+    BinaryField8,
+    BinaryField16,
+    BinaryField32,
+    BinaryField64,
+    BinaryField128,
+    Poly64,
+    Poly192,
+    Ghash128,
+    Rijndael8b,
+);
+
+#[cfg(test)]
+mod pre_patch_060 {
+    extern crate std;
+
+    use std::vec;
+
+    use p3_field::{Field, PrimeCharacteristicRing};
+    use rand::rngs::SmallRng;
+    use rand::{RngExt, SeedableRng};
+
+    use crate::{
+        BinaryField2, BinaryField4, BinaryField8, BinaryField16, BinaryField32,
+        BinaryField64, BinaryField128, Gf2, Ghash128, Poly64, Poly192, Rijndael8b,
+    };
+
+    /// The copies agree with the trait defaults on zero, one, the generator and random
+    /// elements, and `raw_inverse` panics on zero as `Field::inverse` does.
+    macro_rules! check {
+        ($($t:ty),* $(,)?) => {$({
+            let mut rng = SmallRng::seed_from_u64(60);
+            let mut values = vec![<$t>::ZERO, <$t>::ONE, <$t>::GENERATOR];
+            values.extend((0..64).map(|_| rng.random::<$t>()));
+            for x in values {
+                assert_eq!(x.raw_is_zero(), Field::is_zero(&x), "{}", stringify!($t));
+                assert_eq!(x.raw_is_one(), Field::is_one(&x), "{}", stringify!($t));
+                if !Field::is_zero(&x) {
+                    assert_eq!(x.raw_inverse(), Field::inverse(&x), "{}", stringify!($t));
+                }
+            }
+            let zero = <$t>::ZERO;
+            assert!(std::panic::catch_unwind(|| zero.raw_inverse()).is_err());
+        })*};
+    }
+
+    #[test]
+    fn copies_agree_with_the_field_defaults() {
+        check!(
+            Gf2,
+            BinaryField2,
+            BinaryField4,
+            BinaryField8,
+            BinaryField16,
+            BinaryField32,
+            BinaryField64,
+            BinaryField128,
+            Poly64,
+            Poly192,
+            Ghash128,
+            Rijndael8b,
+        );
+    }
+}
