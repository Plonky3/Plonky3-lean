+//! PATCHED: added by Plonky3-lean pre-patch 010 (`cfg-raw-data-serializable-bounds`).
+//!
+//! The patch adds `F: RawDataSerializable` to five impls over `F: TowerLevel`.
+//!
+//! In a normal build `TowerLevel: Field` implies that bound.
+//!
+//! So each impl must still apply to a generic `F: TowerLevel`, with no other bound.
+
+use p3_binary_field::{BinaryChallenger, BinaryField8, BinaryField128, BitCoordinates, TowerLevel};
+use p3_challenger::{CanObserve, CanSample, FieldChallenger, GrindingChallenger, HashChallenger};
+use p3_field::PrimeCharacteristicRing;
+use p3_keccak::Keccak256Hash;
+
+type Challenger<F> = BinaryChallenger<F, HashChallenger<u8, Keccak256Hash, 32>>;
+
+fn dimension<F: TowerLevel>() -> usize {
+    <F as BitCoordinates>::DIMENSION
+}
+
+fn observe<F: TowerLevel>(challenger: &mut Challenger<F>, value: F) {
+    challenger.observe(value);
+}
+
+fn sample<F: TowerLevel>(challenger: &mut Challenger<F>) -> F {
+    challenger.sample()
+}
+
+const fn is_field_challenger<F: TowerLevel, C: FieldChallenger<F> + GrindingChallenger>() {}
+
+fn challengers_are_field_challengers<F: TowerLevel>() {
+    is_field_challenger::<F, Challenger<F>>();
+}
+
+#[test]
+fn the_bounded_impls_apply_to_every_tower_level() {
+    assert_eq!(dimension::<BinaryField8>(), 8);
+    assert_eq!(dimension::<BinaryField128>(), 128);
+
+    let mut challenger = Challenger::<BinaryField128>::from_hasher(vec![], Keccak256Hash);
+    observe(&mut challenger, BinaryField128::ONE);
+    let first: BinaryField128 = sample(&mut challenger);
+
+    let mut again = Challenger::<BinaryField128>::from_hasher(vec![], Keccak256Hash);
+    observe(&mut again, BinaryField128::ONE);
+    assert_eq!(sample(&mut again), first);
+
+    challengers_are_field_challengers::<BinaryField128>();
+}
