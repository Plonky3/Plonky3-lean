# Patch:     030-name-anonymous-const-assertions
# Phase:     post
# Target:    extraction/P3KoalaBear/Extraction/Funs.lean
# Hunks:     9
# Cost:      none. Renames only; the bodies are untouched.
# Upstream:  aeneas names Rust's anonymous `const _: () = assert!(..)` items
#            `__1`, `__2`, …, which mathlib's `linter.style.nameCheck`
#            rejects (one warning each).
# Drop when: aeneas generates a name without a double underscore.
#
# koala-bear's Poseidon tables carry their length invariants as anonymous
# const assertions (eleven of them: two in poseidon1.rs, nine in poseidon2.rs).
# aeneas names the first in each module `_` and the rest `__1`, `__2`, ….
# This patch renames the nine `__N` definitions to `const_check_N`. A `__`
# name is valid Lean, but mathlib's `nameCheck` warns on each one, and the
# build must stay warning-clean without switching linters off. The `_` names
# do not warn, so they are left as `poseidon1._` and `poseidon2._`.
#
--- a/extraction/P3KoalaBear/Extraction/Funs.lean
+++ b/extraction/P3KoalaBear/Extraction/Funs.lean
@@ -1421,7 +1421,7 @@
 /-- [p3_koala_bear::poseidon1::_#1]
     Source: 'koala-bear/src/poseidon1.rs', lines 69:0-72:2 -/
 @[global_simps, irreducible]
-def poseidon1.__1 : RustM Unit := do
+def poseidon1.const_check_1 : RustM Unit := do -- PATCHED: aeneas emitted `poseidon1.__1`
   let a ← poseidon1.KOALABEAR_POSEIDON1_RC_24
   let s ← lift (Array.to_slice a)
   let i ← core.slice.Slice.len s
