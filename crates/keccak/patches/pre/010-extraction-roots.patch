+//! PATCHED: extraction roots for hax's Lean backend, compiled only under `cfg(hax_backend_lean)`.
+//!
+//! Aeneas drops a method that no free function calls (Plonky3-lean, docs/extractor-issues.md, 4).
+//! Each function here calls one method and does nothing else, so that the method's own body is extracted.
+
+use p3_symmetric::{CryptographicHasher, Permutation};
+
+use crate::{Keccak256Hash, KeccakF, Sha3_256Hash, VECTOR_LEN};
+
+pub fn permute_u64(state: [u64; 25]) -> [u64; 25] {
+    <KeccakF as Permutation<[u64; 25]>>::permute(&KeccakF, state)
+}
+
+pub fn permute_mut_u64(state: &mut [u64; 25]) {
+    <KeccakF as Permutation<[u64; 25]>>::permute_mut(&KeccakF, state)
+}
+
+pub fn permute_u8(state: [u8; 200]) -> [u8; 200] {
+    <KeccakF as Permutation<[u8; 200]>>::permute(&KeccakF, state)
+}
+
+pub fn permute_mut_u8(state: &mut [u8; 200]) {
+    <KeccakF as Permutation<[u8; 200]>>::permute_mut(&KeccakF, state)
+}
+
+pub fn permute_mut_packed(state: &mut [[u64; VECTOR_LEN]; 25]) {
+    <KeccakF as Permutation<[[u64; VECTOR_LEN]; 25]>>::permute_mut(&KeccakF, state)
+}
+
+pub fn keccak256_hash_many(input: &[u8], out: &mut [[u8; 32]]) {
+    Keccak256Hash.hash_many(input, out)
+}
+
+pub fn sha3_256_hash_many(input: &[u8], out: &mut [[u8; 32]]) {
+    Sha3_256Hash.hash_many(input, out)
+}
