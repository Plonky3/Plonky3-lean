+//! PATCHED: added by Plonky3-lean pre-patch 020 (`ring-switch-raw-data-bounds`).
+//!
+//! The patch adds `RawDataSerializable` beside `TowerLevel` on 18 bounds of the bit ring switch.
+//!
+//! In a normal build `TowerLevel: Field` implies that bound.
+//!
+//! So the public items must still accept a generic tower level, with no other bound.
+
+use p3_binary_field::{BinaryField8, BinaryField16, BinaryField128, TowerLevel};
+use p3_sumcheck::ring_switch::bits::{
+    BitPacking, BitPackingError, BitRingSwitch, BitRingSwitchShape,
+};
+
+fn pack<F: TowerLevel>(bits: &[u8]) -> Result<BitPacking<F>, BitPackingError> {
+    BitPacking::new(bits)
+}
+
+fn absorbed<F: TowerLevel>() -> usize {
+    BitRingSwitch::<F>::ABSORBED
+}
+
+fn rounds<F: TowerLevel>(shape: &BitRingSwitchShape) -> usize {
+    shape.sumcheck_rounds::<F>()
+}
+
+#[test]
+fn the_bounded_items_accept_every_tower_level() {
+    // Invariant: one element absorbs log_2 of its bit width.
+    assert_eq!(absorbed::<BinaryField8>(), 3);
+    assert_eq!(absorbed::<BinaryField16>(), 4);
+    assert_eq!(absorbed::<BinaryField128>(), 7);
+
+    // Fixture state: a point of 10 coordinates over the 128-bit level.
+    //
+    //     10 coordinates - 7 absorbed = 3 rounds
+    let shape = BitRingSwitchShape::new(10);
+    assert_eq!(rounds::<BinaryField128>(&shape), 3);
+
+    // Fixture state: 32 bytes, so 256 cells, packed into 2 elements of 16 bytes.
+    let bits = [0xA5u8; 32];
+    let packed = pack::<BinaryField128>(&bits).unwrap().into_poly();
+    assert_eq!(packed.num_evals(), 2);
+
+    // Fixture state: 3 bytes is 24 cells, not a power of two.
+    assert_eq!(
+        pack::<BinaryField8>(&[0; 3]).err(),
+        Some(BitPackingError::NotAHypercube { cells: 24 })
+    );
+}
