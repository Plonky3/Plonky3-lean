+//! PATCHED: extraction roots for hax's Lean backend, compiled only under `cfg(hax_backend_lean)`.
+//!
+//! Aeneas drops a method that no free function calls (Plonky3-lean, docs/extractor-issues.md, 4).
+//! Each function here calls one item and does nothing else, so that the item's own body is extracted.
+//!
+//! The field stays generic.
+//! The Lean model then quantifies over every implementation of it.
+
+use alloc::vec::Vec;
+
+use p3_field::Field;
+
+use crate::strategy::Basis;
+
+pub fn lagrange_weights_01inf<F: Field>(r: F) -> [F; 3] {
+    crate::lagrange::lagrange_weights_01inf(r)
+}
+
+pub fn lagrange_weights_01inf_multi<F: Field>(rs: &[F]) -> Vec<F> {
+    crate::lagrange::lagrange_weights_01inf_multi(rs)
+}
+
+pub fn extrapolate_01inf<F: Field>(e0: F, e1: F, e_inf: F, r: F) -> F {
+    crate::lagrange::extrapolate_01inf(e0, e1, e_inf, r)
+}
+
+pub fn reduce_claim<EF: Field>(basis: Basis, c_a: EF, c_inf: EF, r: EF, claimed_sum: EF) -> EF {
+    basis.reduce_claim(c_a, c_inf, r, claimed_sum)
+}
