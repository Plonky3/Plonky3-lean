+//! PATCHED: the items pre-patch 020 hides from the extracted variant, checked in a normal build.
+
+use p3_baby_bear::BabyBear;
+use p3_field::{Field, FieldArray, PrimeCharacteristicRing};
+use p3_matrix::Matrix;
+use p3_matrix::bitrev::BitReversibleMatrix;
+use p3_matrix::dense::RowMajorMatrix;
+use p3_matrix::extension::FlatMatrixView;
+use p3_matrix::horizontally_truncated::HorizontallyTruncated;
+use p3_matrix::interpolation::{Interpolate, InterpolateArbitrary, interpolate_lagrange};
+use p3_matrix::stack::{HorizontalPair, VerticalPair};
+use p3_maybe_rayon::prelude::*;
+
+type F = BabyBear;
+
+fn m() -> RowMajorMatrix<u32> {
+    // Fixture state: 4 rows, 3 columns, entry (r, c) = 10 r + c.
+    //
+    //     |  0  1  2 |
+    //     | 10 11 12 |
+    //     | 20 21 22 |
+    //     | 30 31 32 |
+    RowMajorMatrix::new((0..4).flat_map(|r| (0..3).map(move |c| 10 * r + c)).collect(), 3)
+}
+
+fn check_rows<M: Matrix<u32>>(mat: &M, expect: impl Fn(usize, usize) -> u32) {
+    // Invariant: every row accessor agrees with the expected entry function.
+    let (h, w) = (mat.height(), mat.width());
+    let row = |r: usize| (0..w).map(|c| expect(r, c)).collect::<Vec<_>>();
+    for r in 0..h {
+        assert_eq!(mat.row(r).unwrap().into_iter().collect::<Vec<_>>(), row(r));
+        assert_eq!(&*mat.row_slice(r).unwrap(), &row(r)[..]);
+        unsafe {
+            assert_eq!(mat.get_unchecked(r, 0), expect(r, 0));
+            assert_eq!(mat.row_unchecked(r).into_iter().collect::<Vec<_>>(), row(r));
+            assert_eq!(&*mat.row_slice_unchecked(r), &row(r)[..]);
+            assert_eq!(mat.row_subseq_unchecked(r, 1, w).into_iter().collect::<Vec<_>>(), row(r)[1..]);
+            assert_eq!(&*mat.row_subslice_unchecked(r, 1, w), &row(r)[1..]);
+        }
+
+        // Packed by two along the row, with the odd column in the suffix.
+        let (packed, sfx) = mat.horizontally_packed_row::<[u32; 2]>(r);
+        let flat: Vec<u32> = packed.flatten().chain(sfx).collect();
+        assert_eq!(flat, row(r));
+        let padded: Vec<u32> = mat.padded_horizontally_packed_row::<[u32; 2]>(r).flatten().collect();
+        assert_eq!(&padded[..w], &row(r)[..]);
+
+        // Packed by two down the column, wrapping past the last row.
+        let vp: Vec<[u32; 2]> = mat.vertically_packed_row::<[u32; 2]>(r).collect();
+        assert_eq!(vp, (0..w).map(|c| [expect(r, c), expect((r + 1) % h, c)]).collect::<Vec<_>>());
+        let pair = mat.vertically_packed_row_pair::<[u32; 2]>(r, 2);
+        assert_eq!(pair[w], [expect((r + 2) % h, 0), expect((r + 3) % h, 0)]);
+    }
+    let all: Vec<Vec<u32>> = mat.rows().map(|r| r.collect()).collect();
+    assert_eq!(all, (0..h).map(row).collect::<Vec<_>>());
+    assert_eq!(mat.first_row().map(|r| r.into_iter().collect::<Vec<_>>()), Some(row(0)));
+    assert_eq!(mat.last_row().map(|r| r.into_iter().collect::<Vec<_>>()), Some(row(h - 1)));
+    assert_eq!(&*mat.wrapping_row_slices(h - 1, 2)[1], &row(0)[..]);
+}
+
+#[test]
+fn row_accessors_of_every_view() {
+    // Fixture state: the 4 x 3 matrix above, and each view over it.
+    check_rows(&m(), |r, c| (10 * r + c) as u32);
+    // Bit reversal of 2 bits maps rows 0, 1, 2, 3 to 0, 2, 1, 3.
+    check_rows(&m().bit_reverse_rows(), |r, c| (10 * [0, 2, 1, 3][r] + c) as u32);
+    // Stride 2 from row 1 keeps rows 1 and 3.
+    check_rows(&m().vertically_strided(2, 1), |r, c| (10 * (2 * r + 1) + c) as u32);
+    check_rows(&HorizontallyTruncated::new_with_range(m(), 1..3).unwrap(), |r, c| (10 * r + c + 1) as u32);
+    check_rows(&VerticalPair::new(m(), m()), |r, c| (10 * (r % 4) + c) as u32);
+    check_rows(&HorizontalPair::new(m(), m()), |r, c| (10 * r + c % 3) as u32);
+    assert_eq!(m().contiguous_rows(1..3).unwrap().len(), 6);
+    assert_eq!(m().bit_reverse_rows().to_row_major_matrix().values[3..6], [20, 21, 22]);
+    assert_eq!(m().vertically_strided(2, 0).to_row_major_matrix().values, [0, 1, 2, 20, 21, 22]);
+    assert_eq!(m().par_rows().count(), 4);
+}
+
+#[test]
+fn field_methods() {
+    // Fixture state: 3 rows, 2 columns, entries 1 to 6.
+    //
+    //     | 1 2 |
+    //     | 3 4 |
+    //     | 5 6 |
+    let mat = RowMajorMatrix::new((1..=6).map(F::from_u32).collect(), 2);
+
+    // Weights (1, 1, 2): column sums 1 + 3 + 10 = 14 and 2 + 4 + 12 = 18.
+    let v = [F::ONE, F::ONE, F::TWO];
+    assert_eq!(mat.columnwise_dot_product(&v), vec![F::from_u32(14), F::from_u32(18)]);
+    let batched = mat.columnwise_dot_product_batched::<F, 1>(&v.map(|x| FieldArray([x])));
+    assert_eq!(batched, vec![FieldArray([F::from_u32(14)]), FieldArray([F::from_u32(18)])]);
+
+    // All-ones weights: row sums 3, 7, 11.
+    let ones = vec![<F as Field>::Packing::ONE; 2];
+    let sums: Vec<F> = mat.rowwise_packed_dot_product::<F>(&ones).collect();
+    assert_eq!(sums, vec![F::from_u32(3), F::from_u32(7), F::from_u32(11)]);
+
+    let flat = FlatMatrixView::<F, F, _>::new(mat.clone());
+    assert_eq!(flat.get(2, 1), Some(F::from_u32(6)));
+    assert_eq!(mat.clone().bit_reversed_zero_pad(1).height(), 6);
+
+    // f(x) = 1 + x through (1, 2) and (2, 3): f(3) = 4.
+    let col = RowMajorMatrix::new_col(vec![F::TWO, F::from_u32(3)]);
+    assert_eq!(col.interpolate_arbitrary_point(&[F::ONE, F::TWO], F::from_u32(3)), Some(vec![F::from_u32(4)]));
+    assert_eq!(interpolate_lagrange(&[(F::ONE, F::TWO)]), Some(vec![F::TWO]));
+
+    // A constant column interpolates to itself on the subgroup of order 2.
+    let c = RowMajorMatrix::new_col(vec![F::from_u32(7); 2]);
+    assert_eq!(c.interpolate_subgroup::<F>(F::from_u32(5)), vec![F::from_u32(7)]);
+
+    // Mutation: gating any hidden item on the extraction cfg removes it here, and this file stops compiling.
+}
