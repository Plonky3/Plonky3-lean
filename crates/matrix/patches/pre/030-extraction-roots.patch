+}
+pub fn dense_split_rows<T: Clone + Send + Sync>(m: &M<T>, r: usize) -> (M<T>, M<T>) {
+    let (a, b) = m.split_rows(r);
+    (M::new(a.values.to_vec(), a.width), M::new(b.values.to_vec(), b.width))
+}
+pub fn dense_pad_to_height<T: Clone + Send + Sync + Default>(m: &mut M<T>, h: usize, fill: T) {
