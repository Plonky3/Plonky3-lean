+type M<T> = RowMajorMatrix<T>;
+
+pub fn dense_new<T: Clone + Send + Sync>(values: Vec<T>, width: usize) -> M<T> {
+    M::new(values, width)
+}
+pub fn dense_new_row<T: Clone + Send + Sync>(values: Vec<T>) -> M<T> {
