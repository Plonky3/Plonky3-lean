+}
+pub fn dense_default<T: Clone + Send + Sync + Default>(width: usize, height: usize) -> M<T> {
+    M::default(width, height)
+}
+pub fn dense_width<T: Clone + Send + Sync>(m: &M<T>) -> usize {
