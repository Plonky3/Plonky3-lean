def util.swap_rows
  {F : Type _} (corecloneCloneInst : core.clone.Clone F)
  (mat : dense.DenseMatrix F (alloc.vec.Vec F)) (i : Std.Usize) (j : Std.Usize)
  :
  RustM (dense.DenseMatrix F (alloc.vec.Vec F))
  := do
  let w ←
    dense.DenseMatrix.Insts.P3_matrixMatrix.width corecloneCloneInst
      (alloc.vec.Vec.Insts.P3_matrixDenseDenseStorage corecloneCloneInst) mat
  let (s, deref_mut_back) ←
    alloc.vec.Vec.Insts.CoreOpsDerefDerefMutSlice.deref_mut mat.values
  let i1 ← j * w
  let ((upper, lower), split_at_mut_back) ←
    core.slice.Slice.split_at_mut s i1
  let i2 ← i * w
  let i3 ← i + 1#usize
  let i4 ← i3 * w
  let (row_i, index_mut_back) ←
    core.Slice.Insts.CoreOpsIndexIndexMut.index_mut
      (core.ops.range.RangeUsize.Insts.CoreSliceIndexSliceIndexSliceSlice F)
      upper { start := i2, «end» := i4 }
  let (row_j, index_mut_back1) ←
    core.Slice.Insts.CoreOpsIndexIndexMut.index_mut
      (core.ops.range.RangeToUsize.Insts.CoreSliceIndexSliceIndexSliceSlice F)
      lower { «end» := w }
  let (row_i1, row_j1) ← core.slice.Slice.swap_with_slice row_i row_j
  let upper1 := index_mut_back row_i1
  let lower1 := index_mut_back1 row_j1
  let s1 := split_at_mut_back (upper1, lower1)
  let v := deref_mut_back s1
  ok { mat with values := v }

