  T) (self : stack.HorizontalPair Left Right) (r : Std.Usize) (c : Std.Usize) :
  RustM T
  := do
  let i ← MatrixInst.width self.left
  if c < i
  then MatrixInst.get_unchecked self.left r c
  else let i1 ← c - i
       MatrixInst1.get_unchecked self.right r i1

