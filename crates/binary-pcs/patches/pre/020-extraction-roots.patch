+//! PATCHED: extraction roots for hax's Lean backend, compiled only under `cfg(hax_backend_lean)`.
+//!
+//! Aeneas drops a method that no free function calls (Plonky3-lean, docs/extractor-issues.md, 4).
+//! Each function here calls one item and does nothing else, so that the item's own body is extracted.
+
+use p3_binary_dft::EncodableLevel;
+use p3_binary_field::TowerLevel;
+
+use crate::params::{BinaryPcsConfig, BinaryPcsConfigError, BinaryPcsParams};
+use crate::transcript::BinaryPcsShape;
+
+pub fn try_new_with_folding<F: EncodableLevel, EF: TowerLevel>(
+    num_variables: usize,
+    params: BinaryPcsParams,
+    log_folding_factor: usize,
+) -> Result<BinaryPcsConfig, BinaryPcsConfigError> {
+    BinaryPcsConfig::try_new_with_folding::<F, EF>(num_variables, params, log_folding_factor)
+}
+
+pub fn try_with_folding(
+    config: BinaryPcsConfig,
+    log_folding_factor: usize,
+) -> Result<BinaryPcsConfig, BinaryPcsConfigError> {
+    config.try_with_folding(log_folding_factor)
+}
+
+pub fn num_fold_batches(config: &BinaryPcsConfig) -> usize {
+    config.num_fold_batches()
+}
+
+pub fn shape_new(config: &BinaryPcsConfig) -> BinaryPcsShape {
+    BinaryPcsShape::new(config)
+}
