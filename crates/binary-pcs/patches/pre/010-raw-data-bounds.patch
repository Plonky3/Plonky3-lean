+    serialize = "EF: TowerLevel + p3_field::RawDataSerializable, MT::Commitment: Serialize, MT::MultiProof: Serialize, MX::Commitment: Serialize, MX::MultiProof: Serialize", // PATCHED: adds `RawDataSerializable`, which `Field` implies in a normal build
+    deserialize = "EF: TowerLevel + p3_field::RawDataSerializable, MT::Commitment: Deserialize<'de>, MT::MultiProof: Deserialize<'de>, MX::Commitment: Deserialize<'de>, MX::MultiProof: Deserialize<'de>" // PATCHED: adds `RawDataSerializable`, which `Field` implies in a normal build
 ))]
