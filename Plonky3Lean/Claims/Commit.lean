module

public import Plonky3Lean.Proofs.Commit.BabyBear
public import Plonky3Lean.Proofs.Commit.Encoder
public import Plonky3Lean.Proofs.Commit.Mmcs
public import Plonky3Lean.Proofs.Commit.Pcs
public import Plonky3Lean.Proofs.Commit.PeriodicTable

@[expose] public section

/-!
# p3-commit: claims

The crate is transcribed over a field K, not extracted.

A coset is s H, for H the subgroup of order n = 2^k generated by omega = G_k:

```text
    s H = { s, s omega, ..., s omega^(n - 1) },     u = x / s,     Z(X) = prod_i (X - s omega^i)
```

Notation:

- Z is the monic vanishing polynomial
- L_i is the Lagrange basis
- every interpolant has degree below n

The field facts are hypotheses:

- the generator table is primitive and nested
- 2 is invertible
- the generator g satisfies g^(2^adicity) != 1

BabyBear and every extension of it satisfy all three.
-/

open Polynomial Finset
open p3_commit.domain.mirror p3_commit.periodic.mirror p3_commit.testing.mirror
open p3_commit.pcs.univariate.mirror p3_commit.mmcs.mirror p3_commit.encoder.mirror
open p3_field.coset.mirror p3_dft.mirror
open Plonky3Lean.Spec.Commit Plonky3Lean.Proofs.Dft Plonky3Lean.Proofs.Commit

set_option linter.unusedSectionVars false

namespace Plonky3Lean.Claims.Commit

/-! ## The coset -/

section coset

variable {K : Type _} [Field K] [DecidableEq K] (G : Gen K)

/-- Membership answers whether x lies in s H. -/
theorem coset.contains {adicity : ℕ} {gen : ℕ → K} (c : TwoAdicMultiplicativeCoset K adicity gen)
    (hω : IsPrimitiveRoot (gen c.log_size) (2 ^ c.log_size)) (x : K) :
    c.contains x = true ↔ InCoset c.shift (gen c.log_size) c.log_size x :=
  contains_iff c hω x

/-- Element i is s omega^i, for any i. -/
theorem coset.element (hV : GenValid G) (hN : GenNested G) (c : Coset G) (i : ℕ) :
    c.element i = c.shift * c.subgroup_generator ^ i :=
  element_eq G hV hN c i

/-- The iterator lists s omega^i for i < n, and the size is n. -/
theorem coset.iter (c : Coset G) :
    c.iter = (List.range (2 ^ c.log_size)).map (fun i => c.shift * c.subgroup_generator ^ i) ∧
      c.size = 2 ^ c.log_size ∧ c.shift_inverse = c.shift⁻¹ :=
  ⟨rfl, rfl, rfl⟩

/-- Raising to 2^l maps s H to s^(2^l) H^(2^l), the coset of order n / 2^l.

It panics for 2^l > n. -/
theorem coset.exp_power_of_2 (hN : GenNested G) (c : Coset G) (l : ℕ) :
    (l ≤ c.log_size → ∃ d, c.exp_power_of_2 l = some d ∧ d.shift = c.shift ^ 2 ^ l ∧
      d.log_size = c.log_size - l ∧ d.subgroup_generator = c.subgroup_generator ^ 2 ^ l) ∧
    (c.log_size < l → c.exp_power_of_2 l = none) := by
  refine ⟨fun hl => ⟨⟨c.shift ^ 2 ^ l, c.log_size - l, pow_ne_zero _ c.shift_ne_zero,
    by have := c.log_size_le; omega⟩, ?_, rfl, rfl, gen_sub G hN c.log_size_le hl⟩, fun hl => ?_⟩
  · simp [TwoAdicMultiplicativeCoset.exp_power_of_2, TwoAdicMultiplicativeCoset.shrink_coset, hl]
  · simp [TwoAdicMultiplicativeCoset.exp_power_of_2, TwoAdicMultiplicativeCoset.shrink_coset,
      not_le.mpr hl]

/-- Replacing or scaling the shift panics exactly when the new shift is zero. -/
theorem coset.set_shift (c : Coset G) (t : K) :
    (c.set_shift t = none ↔ t = 0) ∧ (c.shift_by t = none ↔ t = 0) := by
  simp [TwoAdicMultiplicativeCoset.set_shift, TwoAdicMultiplicativeCoset.shift_by, c.shift_ne_zero]

/-- The first point is s, and the next point of s omega^i is s omega^((i + 1) mod n). -/
theorem next_point (hV : GenValid G) (c : Coset G) (i : ℕ) :
    Coset.first_point G c = cosetPoints c.shift c.subgroup_generator c.log_size ⟨0, by simp⟩ ∧
      Coset.next_point G c (c.shift * c.subgroup_generator ^ i) =
        some (c.shift * c.subgroup_generator ^ ((i + 1) % 2 ^ c.log_size)) :=
  ⟨first_point_eq G c, next_point_eq G hV c i⟩

/-- A disjoint domain exists exactly for a minimum size at most 2^adicity. -/
theorem create_disjoint_domain.some_iff (c : Coset G) {g : K} (hg : g ≠ 0) (m : ℕ) :
    (Coset.try_create_disjoint_domain G c g m).isSome ↔ m ≤ 2 ^ G.adicity :=
  try_create_disjoint_domain_eq G c g hg m

/-- The disjoint domain has shift s g and size 2^ceil(log_2 m), at least m. -/
theorem create_disjoint_domain.shape {c d : Coset G} {g : K} {m : ℕ}
    (h : Coset.try_create_disjoint_domain G c g m = some d) :
    d.shift = c.shift * g ∧ d.log_size = log2Ceil m ∧ m ≤ Coset.size G d :=
  try_create_disjoint_domain_some G h

/-- If g^(2^adicity) != 1, the disjoint domain shares no point with s H. -/
theorem create_disjoint_domain.disjoint (hV : GenValid G) {c d : Coset G} {g : K} {m : ℕ}
    (hg : g ^ 2 ^ G.adicity ≠ 1) (h : Coset.try_create_disjoint_domain G c g m = some d)
    (i : Fin (2 ^ d.log_size)) (j : Fin (2 ^ c.log_size)) :
    cosetPoints d.shift d.subgroup_generator d.log_size i ≠
      cosetPoints c.shift c.subgroup_generator c.log_size j :=
  Plonky3Lean.Proofs.Commit.disjoint G hV hg h i j

/-- Splitting into 2^l <= n chunks gives the cosets s omega^i H^(2^l), in order. -/
theorem split_domains (hV : GenValid G) (c : Coset G) {l : ℕ} (hl : l ≤ c.log_size) :
    Coset.split_domains G c (2 ^ l) = some ((List.range (2 ^ l)).map (chunk G hV c l)) :=
  split_domains_eq G hV c hl

/-- Splitting succeeds exactly for a power-of-two chunk count at most n. -/
theorem split_domains.some_iff (hV : GenValid G) (c : Coset G) (nc : ℕ) :
    (Coset.split_domains G c nc).isSome ↔ ∃ l, nc = 2 ^ l ∧ l ≤ c.log_size :=
  split_domains_isSome G hV c nc

/-- The quotient commit hands the masking step exactly as many evaluations as its chunk count.

Guarding that step with a count check changes nothing. -/
theorem commit_quotient.counts : type_of% @commit_quotient_counts := @commit_quotient_counts

/-- Point j of chunk i is point i + 2^l j of the coset. -/
theorem split_domains.points (hV : GenValid G) (hN : GenNested G) (c : Coset G) {l : ℕ}
    (hl : l ≤ c.log_size) (i j : ℕ) :
    (chunk G hV c l i).shift * (chunk G hV c l i).subgroup_generator ^ j =
      c.shift * c.subgroup_generator ^ (i + 2 ^ l * j) :=
  chunk_point G hV hN c hl i j

/-- The chunks partition s H: each point lies in exactly one chunk. -/
theorem split_domains.partition (hV : GenValid G) (hN : GenNested G) (c : Coset G) {l : ℕ}
    (hl : l ≤ c.log_size) (x : K) :
    InCoset c.shift c.subgroup_generator c.log_size x ↔
      ∃! i, i < 2 ^ l ∧ InCoset (chunk G hV c l i).shift (chunk G hV c l i).subgroup_generator
        (chunk G hV c l i).log_size x :=
  split_partition G hV hN c hl x

/-- Row j of evaluation chunk i is row i + 2^l j, the value at point j of chunk i. -/
theorem split_evals {V : Type _} [Zero V] (c : Coset G) {l : ℕ} (hl : l ≤ c.log_size)
    (rows : ℕ → V) :
    Coset.split_evals G c (2 ^ l) (Coset.size G c) rows =
      some ((List.range (2 ^ l)).map fun i j =>
        if j < 2 ^ (c.log_size - l) then rows (i + 2 ^ l * j) else 0) :=
  split_evals_eq G c hl rows

/-- Evaluations of the wrong height panic. -/
theorem split_evals.panics {V : Type _} [Zero V] (c : Coset G) (nc h : ℕ) (rows : ℕ → V)
    (hh : h ≠ Coset.size G c) : Coset.split_evals G c nc h rows = none :=
  split_evals_height G c nc h rows hh

/-- The vanishing polynomial is normalized by s^n: (x / s)^n - 1 = Z(x) / s^n. -/
theorem vanishing_poly_at_point (hV : GenValid G) (c : Coset G) (x : K) :
    Coset.vanishing_poly_at_point G c x =
      (vanishing c.shift c.subgroup_generator c.log_size).eval x / c.shift ^ 2 ^ c.log_size :=
  vanishing_poly_at_point_eq G hV c x

/-- It is zero exactly on s H. -/
theorem vanishing_poly_at_point.eq_zero (hV : GenValid G) (c : Coset G) (x : K) :
    Coset.vanishing_poly_at_point G c x = 0 ↔ InCoset c.shift c.subgroup_generator c.log_size x :=
  vanishing_poly_at_point_eq_zero G hV c x

/-- The selectors at a point panic exactly on s H. -/
theorem selectors_at_point.panics (hV : GenValid G) (c : Coset G) (x : K) :
    Coset.selectors_at_point G c x = none ↔ InCoset c.shift c.subgroup_generator c.log_size x :=
  selectors_at_point_none G hV c x

/-- Off s H, the selectors are:

- n L_0(x)
- n omega L_(n-1)(x)
- (x - s omega^(n-1)) / s
- s^n / Z(x). -/
theorem selectors_at_point (hV : GenValid G) (h2 : (2 : K) ≠ 0) (c : Coset G) (x : K)
    (hx : ¬ InCoset c.shift c.subgroup_generator c.log_size x) :
    Coset.selectors_at_point G c x = some
      ⟨(2 ^ c.log_size : K) * (lagrange c.shift c.subgroup_generator c.log_size 0).eval x,
       (2 ^ c.log_size : K) * c.subgroup_generator *
         (lagrange c.shift c.subgroup_generator c.log_size (lastIdx c.log_size)).eval x,
       (x - cosetPoints c.shift c.subgroup_generator c.log_size (lastIdx c.log_size)) / c.shift,
       c.shift ^ 2 ^ c.log_size / (vanishing c.shift c.subgroup_generator c.log_size).eval x⟩ :=
  selectors_at_point_some G hV h2 c x hx

/-- Take a coset t H' of order N >= n with t^N != 1.

The vectors list the selectors at each point x_m = t omega'^m. -/
theorem selectors_on_coset (hV : GenValid G) (hN : GenNested G) {c coset : Coset G}
    (h1 : c.shift = 1) (hle : c.log_size ≤ coset.log_size)
    (hdisj : coset.shift ^ 2 ^ coset.log_size ≠ 1) :
    Coset.selectors_on_coset G c coset = some
      ⟨(List.range (2 ^ coset.log_size)).map fun m =>
          ((coset.shift * coset.subgroup_generator ^ m) ^ 2 ^ c.log_size - 1) *
            (coset.shift * coset.subgroup_generator ^ m - 1)⁻¹,
       (List.range (2 ^ coset.log_size)).map fun m =>
          ((coset.shift * coset.subgroup_generator ^ m) ^ 2 ^ c.log_size - 1) *
            (coset.shift * coset.subgroup_generator ^ m - c.subgroup_generator⁻¹)⁻¹,
       (List.range (2 ^ coset.log_size)).map fun m =>
          coset.shift * coset.subgroup_generator ^ m - c.subgroup_generator⁻¹,
       (List.range (2 ^ coset.log_size)).map fun m =>
          ((coset.shift * coset.subgroup_generator ^ m) ^ 2 ^ c.log_size - 1)⁻¹⟩ :=
  selectors_on_coset_eq G hV hN h1 hle hdisj

/-- The tabulation panics exactly in three cases:

- the subgroup's shift is not one
- the coset is smaller than the subgroup
- t^N = 1. -/
theorem selectors_on_coset.panics (hV : GenValid G) (hN : GenNested G) (c coset : Coset G) :
    Coset.selectors_on_coset G c coset = none ↔
      c.shift ≠ 1 ∨ coset.log_size < c.log_size ∨ coset.shift ^ 2 ^ coset.log_size = 1 :=
  selectors_on_coset_none G hV hN c coset

/-- Entry m of the tabulated vectors is the selectors at the point x_m. -/
theorem selectors_on_coset.at_point (hV : GenValid G) (hN : GenNested G) {c coset : Coset G}
    (h1 : c.shift = 1) (hle : c.log_size ≤ coset.log_size)
    (hdisj : coset.shift ^ 2 ^ coset.log_size ≠ 1) {sel : LagrangeSelectors (List K)}
    (hsel : Coset.selectors_on_coset G c coset = some sel) (m : ℕ) (hm : m < 2 ^ coset.log_size) :
    Coset.selectors_at_point G c (coset.shift * coset.subgroup_generator ^ m) =
      some ⟨sel.is_first_row.getD m 0, sel.is_last_row.getD m 0, sel.is_transition.getD m 0,
        sel.inv_vanishing.getD m 0⟩ :=
  selectors_on_coset_at_point G hV hN h1 hle hdisj hsel m hm

/-- On the disjoint domain of a subgroup, the tabulation never panics.

This needs the generator to satisfy g^(2^adicity) != 1. -/
theorem selectors_on_coset.disjoint_domain (hV : GenValid G) (hN : GenNested G) {c d : Coset G}
    {g : K} {m : ℕ} (h1 : c.shift = 1) (hg : g ^ 2 ^ G.adicity ≠ 1)
    (hd : Coset.try_create_disjoint_domain G c g m = some d) (hle : c.log_size ≤ d.log_size) :
    (Coset.selectors_on_coset G c d).isSome :=
  Plonky3Lean.Proofs.Commit.selectors_on_disjoint_domain G hV hN h1 hg hd hle

end coset

/-! ## Periodic columns -/

section periodic

variable {K : Type _} [Field K] [DecidableEq K] (G : Gen K)

/-- Evaluations of length 2^k interpolate over the coset of that order with the domain's shift. -/
theorem evaluate_polynomial_at (hV : GenValid G) (h2 : (2 : K) ≠ 0) (c : Coset G) (evals : List K)
    {k : ℕ} (hlen : evals.length = 2 ^ k) (hk : k ≤ G.adicity) (x : K) :
    Coset.evaluate_polynomial_at G c evals x =
      some ((interpolant c.shift (G.gen k) k fun i => evals.getD i.val 0).eval x) :=
  evaluate_polynomial_at_eq G hV h2 c evals hlen hk x

/-- A column of length 2^l <= n evaluates to its periodic polynomial.

That polynomial interpolates col[i mod 2^l] over s H. -/
theorem evaluate_periodic_column_at (hV : GenValid G) (hN : GenNested G) (h2 : (2 : K) ≠ 0)
    (c : Coset G) (col : List K) {l : ℕ} (hcol : col.length = 2 ^ l) (hl : l ≤ c.log_size) (x : K) :
    Coset.evaluate_periodic_column_at G c col x =
      some ((periodicPoly c.shift c.subgroup_generator c.log_size col).eval x) :=
  evaluate_periodic_column_at_eq G hV hN h2 c col hcol hl x

/-- The trait default evaluates the same polynomial, for any nonempty column. -/
theorem default_evaluate_periodic_column_at (hV : GenValid G) (h2 : (2 : K) ≠ 0) (c : Coset G)
    (col : List K) (hcol : col.length ≠ 0) (x : K) :
    Coset.default_evaluate_periodic_column_at G c col x =
      some ((periodicPoly c.shift c.subgroup_generator c.log_size col).eval x) :=
  default_evaluate_periodic_column_at_eq G hV h2 c col hcol x

/-- The override panics on a length that is not a power of two, where the default does not. -/
theorem evaluate_periodic_column_at.panics_not_pow (c : Coset G) (col : List K)
    (hcol : ∀ l, col.length ≠ 2 ^ l) (x : K) : Coset.evaluate_periodic_column_at G c col x = none :=
  evaluate_periodic_column_at_not_pow G c col hcol x

/-- The override panics on a power of two longer than the trace. -/
theorem evaluate_periodic_column_at.panics_long (c : Coset G) (col : List K) {l : ℕ}
    (hcol : col.length = 2 ^ l) (hl : c.log_size < l) (x : K) :
    Coset.evaluate_periodic_column_at G c col x = none :=
  evaluate_periodic_column_at_long G c col hcol hl x

/-- The batched evaluation agrees with the column-by-column default, panics included. -/
theorem evaluate_periodic_columns_at (hV : GenValid G) (hN : GenNested G) (h2 : (2 : K) ≠ 0)
    (c : Coset G) (cols : List (List K)) (height : ℕ) (x : K) :
    Coset.evaluate_periodic_columns_at G c cols height x =
      Coset.default_evaluate_periodic_columns_at G c cols height x :=
  evaluate_periodic_columns_at_eq_default G hV hN h2 c cols height x

/-- The screen accepts exactly when every length is a power of two dividing the height. -/
theorem PeriodicColumns.new.ok_iff (cols : List (List K)) (height : ℕ) :
    PeriodicColumns.new cols height = .ok ⟨cols, height⟩ ↔ ∀ col ∈ cols, ColumnOk height col :=
  new_ok_iff cols height

/-- A reported error names the first failing column. -/
theorem PeriodicColumns.new.error (cols : List (List K)) (height : ℕ) (e : PeriodicColumnShapeError)
    (h : PeriodicColumns.new cols height = .error e) :
    ∃ i, ∃ hi : i < cols.length, ¬ ColumnOk height cols[i] ∧ e = screenError height (cols[i], i) ∧
      ∀ j (hj : j < i), ColumnOk height (cols[j]'(by omega)) :=
  new_error cols height e h

/-- On a power-of-two height, the packed group period is height / gcd(height, pack width). -/
theorem PeriodicLdeTable.packed_group_period (t : PeriodicLdeTable K) {a : ℕ} (ht : t.height = 2 ^ a)
    (ha : a < 64) {w : ℕ} (hw : w ≠ 0) (hw64 : w < 2 ^ 64) :
    t.packed_group_period w = some (t.height / Nat.gcd t.height w) :=
  packed_group_period_eq t ht ha hw hw64

/-- Group g of the packed reads sees the same values as group g mod that period. -/
theorem PeriodicLdeTable.get.packed (t : PeriodicLdeTable K) {a : ℕ} (ht : t.height = 2 ^ a)
    (w g o c : ℕ) :
    t.get (g * w + o) c = t.get ((g % (t.height / Nat.gcd t.height w)) * w + o) c :=
  get_packed_period t ht w g o c

/-- On good columns, the table holds P 2^b rows, for the largest period P.

A read at any LDE index i is the column's periodic polynomial at quotient point i. -/
theorem build_periodic_lde_table (hV : GenValid G) (hN : GenNested G) (h2 : (2 : K) ≠ 0)
    (trace quotient : Coset G) (cols : List (List K)) (hle : trace.log_size ≤ quotient.log_size)
    (hcols : ∀ col ∈ cols, ∃ l, col.length = 2 ^ l ∧ l ≤ trace.log_size) (hne : cols ≠ [])
    (hword : Coset.size G quotient * cols.length < 2 ^ 64) :
    ∃ t, p3_commit.periodic.mirror.build_periodic_lde_table G cols trace quotient = some t ∧
      t.width = cols.length ∧
      (∃ mp ∈ cols.map List.length, t.height = mp * 2 ^ (quotient.log_size - trace.log_size)) ∧
      ∀ i c (hc : c < cols.length), t.get i c =
        some ((periodicPoly trace.shift trace.subgroup_generator trace.log_size cols[c]).eval
          (quotient.shift * quotient.subgroup_generator ^ i)) :=
  build_periodic_lde_table_eq G hV hN h2 trace quotient cols hle hcols hne hword

/-- A column that fails the screen makes the table builder panic. -/
theorem build_periodic_lde_table.panics (trace quotient : Coset G) (cols : List (List K))
    (h : ∃ col ∈ cols, ¬ ColumnOk (Coset.size G trace) col) :
    p3_commit.periodic.mirror.build_periodic_lde_table G cols trace quotient = none :=
  build_periodic_lde_table_bad G trace quotient cols h

/-- No periodic columns give the empty table. -/
theorem build_periodic_lde_table.nil (trace quotient : Coset G)
    (hle : trace.log_size ≤ quotient.log_size) :
    p3_commit.periodic.mirror.build_periodic_lde_table G [] trace quotient =
      some PeriodicLdeTable.empty :=
  build_periodic_lde_table_nil G trace quotient hle

end periodic

/-! ## Commitment schemes -/

section schemes

/-- Two accepted claims about one commitment, matrix, domain and point carry the same values.

The only exception is the contract's break event on that commitment. -/
theorem pcs.binding {K : Type _} [Field K] {pcs : UnivariatePcs K} (C : pcs.Contract)
    {cl₁ cl₂ : List (CommitmentOpening K pcs.Commitment pcs.Domain)} {pf₁ pf₂ : pcs.Proof}
    {ch₁ ch₂ b₁ b₂ : pcs.Challenger}
    (h₁ : pcs.verify cl₁ pf₁ ch₁ = some (true, b₁)) (h₂ : pcs.verify cl₂ pf₂ ch₂ = some (true, b₂))
    {o₁ o₂ : CommitmentOpening K pcs.Commitment pcs.Domain} (ho₁ : o₁ ∈ cl₁) (ho₂ : o₂ ∈ cl₂)
    (hcm : o₁.commitment = o₂.commitment) {m : ℕ} (hm₁ : m < o₁.matrices.length)
    (hm₂ : m < o₂.matrices.length) (hd : o₁.matrices[m].domain = o₂.matrices[m].domain)
    {p₁ p₂ : PointOpening K} (hp₁ : p₁ ∈ o₁.matrices[m].points) (hp₂ : p₂ ∈ o₂.matrices[m].points)
    (hz : p₁.point = p₂.point) : p₁.values = p₂.values ∨ C.Broken o₁.commitment :=
  UnivariatePcs.Contract.binding C h₁ h₂ ho₁ ho₂ hcm hm₁ hm₂ hd hp₁ hp₂ hz

variable {K : Type} [Field K] [DecidableEq K] (G : Gen K)

/-- The trivial scheme meets the univariate contract, and nothing breaks its binding.

This holds over any backend that computes the inverse transform. -/
theorem trivial.contract (hV : GenValid G) (C : Type)
    {idft : (w : ℕ) → ℕ → (ℕ → Fin w → K) → Option (ℕ → Fin w → K)} (hidft : IdftComputes G idft)
    (pcs : TrivialPcs) : ∃ c : (trivialScheme G C idft pcs).Contract, ∀ cm, ¬ c.Broken cm :=
  ⟨trivialContract G hV hidft, fun _ h => h⟩

/-- The same, at the parallel radix-2 backend. -/
theorem trivial.contract.parallel (hV : GenValid G) (C : Type) (pcs : TrivialPcs) :
    ∃ c : (trivialScheme G C
      (fun _ h x => p3_dft.radix_2_dit_parallel.mirror.Radix2DitParallel.idft_batch G h x) pcs).Contract,
      ∀ cm, ¬ c.Broken cm :=
  ⟨trivialContract G hV (parallel_idftComputes G hV), fun _ h => h⟩

/-- Commit a coefficient matrix of height h with the trivial scheme of log size k.

Its evaluations on 2^D points have h 2^(D - k) rows. -/
theorem trivial.get_evaluations_on_domain.height
    (coset_dft : (w : ℕ) → ℕ → K → (ℕ → Fin w → K) → Option (ℕ → Fin w → K)) (pcs : TrivialPcs)
    (pd : List (Mat K)) (idx : ℕ) (domain : Coset G) (c : Mat K) (hc : pd[idx]? = some c)
    (hw : c.width ≠ 0) (out : Mat K)
    (h : pcs.get_evaluations_on_domain G coset_dft pd idx domain = some out) :
    out.height = c.height * 2 ^ (domain.log_size - pcs.log_n) :=
  get_evaluations_on_domain_height G coset_dft pd idx domain c hc hw out h

/-- The default quotient commit extends each chunk of the quotient domain.

Chunk i receives the quotient's values at its points i + 2^l j. -/
theorem commit_quotient (hV : GenValid G) {α : Type _}
    (get_quotient_ldes : List (Coset G × Mat K) → ℕ → Option (List (Mat K)))
    (commit_ldes : List (Mat K) → Option α) (qd : Coset G) (evals : Mat K)
    (hh : evals.height = Coset.size G qd) {l : ℕ} (hl : l ≤ qd.log_size) :
    p3_commit.pcs.univariate.mirror.commit_quotient G get_quotient_ldes commit_ldes qd evals (2 ^ l) =
      (get_quotient_ldes ((List.range (2 ^ l)).map fun i => (chunk G hV qd l i,
        (⟨2 ^ (qd.log_size - l), evals.width, fun j =>
          if j < 2 ^ (qd.log_size - l) then evals.entry (i + 2 ^ l * j) else 0⟩ : Mat K))) (2 ^ l)).bind
        commit_ldes :=
  commit_quotient_eq G hV get_quotient_ldes commit_ldes qd evals hh hl

/-- The default opening with preprocessing panics on a hiding scheme.

Otherwise it opens as usual. -/
theorem open_with_preprocessing {R C α : Type _} (zk : Bool) (open_ : R → C → α) (r : R) (c : C)
    (p : Option ℕ) :
    p3_commit.pcs.univariate.mirror.open_with_preprocessing zk open_ r c p =
      if zk then none else some (open_ r c) := rfl

/-- The default verification with preprocessing ignores the index, hiding or not. -/
theorem verify_with_preprocessing {R P C α : Type _} (verify : R → P → C → α) (r : R) (pf : P) (c : C)
    (p : Option ℕ) :
    p3_commit.pcs.univariate.mirror.verify_with_preprocessing verify r pf c p = verify r pf c := rfl

end schemes

section mmcs

/-- The default maximum height is the tallest height, and panics exactly on an empty batch. -/
theorem mmcs.get_max_height {T : Type _} (mmcs : Mmcs T) (C : mmcs.Contract) (ms : List (Mat T)) cd
    (h : mmcs.commit ms = some cd) :
    get_max_height mmcs.get_matrices cd.2 = if ms = [] then none else some (maxHeight ms) :=
  get_max_height_eq mmcs C ms cd h

/-- A scheme that commits the matrices themselves meets the contract.

So the contract is satisfiable. -/
theorem mmcs.reference {T : Type} [DecidableEq T] :
    ∃ c : (referenceMmcs (T := T)).Contract, ∀ cm, ¬ c.Broken cm :=
  ⟨referenceContract, fun _ h => h⟩

open p3_commit.adapters.extension_mmcs.mirror in
/-- The extension adapter over a scheme that meets the contract meets it too.

It keeps the same failure event. -/
theorem mmcs.extension {F EF : Type} [Zero F] (B : Basis F EF) (hD : 0 < B.D)
    (hB : ∀ e, B.ofCoords (B.coords e) = e) (m : Mmcs F) (C : m.Contract) :
    ∃ c : (extMmcs B m).Contract, ∀ cm, c.Broken cm ↔ C.Broken cm :=
  ⟨extContract B hD hB m C, fun _ => Iff.rfl⟩

end mmcs

/-! ## One-line defaults -/

section oneLine

variable {K : Type _} [Field K] [DecidableEq K] (G : Gen K)

/-- The panicking disjoint domain is the non-panicking one. -/
theorem create_disjoint_domain (c : Coset G) (g : K) (m : ℕ) :
    Coset.create_disjoint_domain G c g m = Coset.try_create_disjoint_domain G c g m := rfl

/-- The natural domain of degree 2^l is the subgroup of that order, for l at most the adicity. -/
theorem natural_domain_for_degree {l : ℕ} (hl : l ≤ G.adicity) :
    p3_commit.testing.mirror.natural_domain_for_degree G (2 ^ l) = some ⟨1, l, one_ne_zero, hl⟩ := by
  simp [p3_commit.testing.mirror.natural_domain_for_degree, log2Strict_pow,
    TwoAdicMultiplicativeCoset.new, hl]

/-- A degree that is not a power of two panics. -/
theorem natural_domain_for_degree.panics {d : ℕ} (hd : ∀ l, d ≠ 2 ^ l) :
    p3_commit.testing.mirror.natural_domain_for_degree G d = none := by
  simp [p3_commit.testing.mirror.natural_domain_for_degree, log2Strict_eq_none hd]

/-- Three defaults delegate directly:

- the preprocessing commit is the plain commit
- the unrandomized evaluations are the plain evaluations
- there is no randomization commitment. -/
theorem delegating_defaults {α PD β : Type _} (commit : List (Coset G × Mat K) → α)
    (ev : List (Coset G × Mat K)) (get : PD → ℕ → Coset G → β) (pd : PD) (idx : ℕ) (d : Coset G) :
    commit_preprocessing G commit ev = commit ev ∧
      get_evaluations_on_domain_no_random G get pd idx d = get pd idx d ∧
      (get_opt_randomization_poly_commitment : Option (Option α)) = some none :=
  ⟨rfl, rfl, rfl⟩

/-- The evaluator for no periodic columns panics exactly when columns are present. -/
theorem unit_evaluator (cols : List (List K)) :
    (unitEvalOnLde cols = none ↔ cols ≠ []) ∧ (unitEvalAtPoint cols = none ↔ cols ≠ []) := by
  cases cols <;> simp [unitEvalOnLde, unitEvalAtPoint]

/-- An empty table holds no values. -/
theorem PeriodicLdeTable.is_empty (t : PeriodicLdeTable K) : t.is_empty = true ↔ t.values = [] := by
  simp [p3_commit.periodic.mirror.PeriodicLdeTable.is_empty]

/-- The single-matrix and vector commits are commits of one matrix. -/
theorem mmcs.commit_matrix {T α : Type _} [Inhabited T] (commit : List (Mat T) → α) (m : Mat T)
    (v : List T) :
    p3_commit.mmcs.mirror.commit_matrix commit m = commit [m] ∧
      p3_commit.mmcs.mirror.commit_vec commit v = commit [⟨v.length, 1, fun r _ => v.getD r default⟩] :=
  ⟨rfl, rfl⟩

end oneLine

/-! ## The encoder -/

section encoder

variable {K : Type _} [Field K] [DecidableEq K] (G : Gen K)

/-- The padding keeps len 2^r exactly when the rate is below 64 and len 2^r fits the word. -/
theorem paddedLen (len r : ℕ) :
    p3_commit.encoder.mirror.paddedLen len r =
      if r < 64 ∧ len * 2 ^ r < 2 ^ 64 then some (len * 2 ^ r) else none :=
  paddedLen_eq len r

/-- A message of height 2^k encodes at rate 2^(-r).

The codeword is its column polynomials at the 2^(k + r) powers of G_(k + r). -/
theorem encode_batch {dft : (w : ℕ) → ℕ → (ℕ → Fin w → K) → Option (ℕ → Fin w → K)}
    (hdft : DftComputes G dft) (m : Mat K) {k r : ℕ} (hh : m.height = 2 ^ k) (hw : m.width ≠ 0)
    (hk : k + r ≤ G.adicity) (hr : r < 64) (hword : m.height * m.width * 2 ^ r < 2 ^ 64) :
    ∃ e, p3_commit.encoder.mirror.encode_batch dft m r = some ⟨2 ^ (k + r), m.width, e⟩ ∧
      ∀ i < 2 ^ (k + r), ∀ c,
        e i c = (Spec.Dft.poly (2 ^ k) fun j => m.entry j c).eval (G.gen (k + r) ^ i) :=
  encode_batch_eq G hdft m hh hw hk hr hword

/-- The borrowed encoding gives the same codeword. -/
theorem encode_batch_borrowed {dft : (w : ℕ) → ℕ → (ℕ → Fin w → K) → Option (ℕ → Fin w → K)}
    (hdft : DftComputes G dft) (m : Mat K) {k r : ℕ} (hh : m.height = 2 ^ k) (hw : m.width ≠ 0)
    (hk : k + r ≤ G.adicity) (hr : r < 64) (hword : m.height * m.width * 2 ^ r < 2 ^ 64) :
    ∃ e, p3_commit.encoder.mirror.encode_batch_borrowed dft m r = some ⟨2 ^ (k + r), m.width, e⟩ ∧
      ∀ i < 2 ^ (k + r), ∀ c,
        e i c = (Spec.Dft.poly (2 ^ k) fun j => m.entry j c).eval (G.gen (k + r) ^ i) :=
  encode_batch_borrowed_eq G hdft m hh hw hk hr hword

/-- At a positive rate, the encoder panics in two cases:

- the padded length leaves the word
- the rate is 64 or more. -/
theorem encode_batch.panics (dft : (w : ℕ) → ℕ → (ℕ → Fin w → K) → Option (ℕ → Fin w → K))
    (m : Mat K) {r : ℕ} (hr : 0 < r) (h : ¬ (r < 64 ∧ m.height * m.width * 2 ^ r < 2 ^ 64)) :
    p3_commit.encoder.mirror.encode_batch dft m r = none :=
  encode_batch_overflow dft m hr h

end encoder

/-! ## BabyBear and its extensions -/

section babyBear

/-- BabyBear's generator table is primitive and nested up to 27.

Its generator lies outside the subgroup of order 2^27. -/
theorem babyBear.facts :
    ∃ t g, Plonky3Lean.Spec.BabyBear.TwoAdicParams.TWO_ADIC_GENERATORS = .ok t ∧
      Plonky3Lean.Spec.BabyBear.FieldParams.MONTY_GEN = .ok g ∧
      (genOfTable (t.val.map Plonky3Lean.Spec.BabyBear.toField)).adicity = 27 ∧
      GenValid (genOfTable (t.val.map Plonky3Lean.Spec.BabyBear.toField)) ∧
      GenNested (genOfTable (t.val.map Plonky3Lean.Spec.BabyBear.toField)) ∧
      Plonky3Lean.Spec.BabyBear.toField g ^ 2 ^ 27 ≠ 1 :=
  babyBear_facts

/-- Take any extension E of BabyBear, the quartic one included.

The prover's quotient coset never meets the trace subgroup.

Its selectors never panic. -/
theorem babyBear.selectors_on_disjoint_domain (E : Type) [Field E] [DecidableEq E]
    [Algebra BabyBear.Field E] :
    ∃ t g, Plonky3Lean.Spec.BabyBear.TwoAdicParams.TWO_ADIC_GENERATORS = .ok t ∧
      Plonky3Lean.Spec.BabyBear.FieldParams.MONTY_GEN = .ok g ∧
      ∀ (c d : Coset (Gen.map (genOfTable (t.val.map Plonky3Lean.Spec.BabyBear.toField))
          (algebraMap BabyBear.Field E))) (m : ℕ),
        c.shift = 1 → c.log_size ≤ d.log_size →
        Coset.try_create_disjoint_domain _ c
          (algebraMap BabyBear.Field E (Plonky3Lean.Spec.BabyBear.toField g)) m = some d →
        (Coset.selectors_on_coset _ c d).isSome := by
  obtain ⟨t, g, ht, hg, ha, hV, hN, hout⟩ := babyBear_facts
  refine ⟨t, g, ht, hg, fun c d m h1 hle hd => ?_⟩
  refine Plonky3Lean.Proofs.Commit.selectors_on_disjoint_domain _ (genValid_map hV _) (genNested_map hN _) h1 ?_ hd hle
  show (algebraMap BabyBear.Field E _) ^ 2 ^ (genOfTable _).adicity ≠ 1
  rw [ha, ← map_pow, ne_eq, map_eq_one_iff _ (algebraMap BabyBear.Field E).injective]
  exact hout

end babyBear

end Plonky3Lean.Claims.Commit
