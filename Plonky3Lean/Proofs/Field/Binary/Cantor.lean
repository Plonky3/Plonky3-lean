/-- `v_i`, vector `i` of the Cantor basis. -/
def cantorV (i : ℕ) : ℕ := cantorLit.getD i 0

theorem cantorV_eq (i : ℕ) : cantorV i = (cantor.CANTOR_BASIS_128.val.getD i 0#u128).val := by
  rw [cantorV, ← cantorNat_eq, cantorNat, List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
    List.getElem?_map]
  cases cantor.CANTOR_BASIS_128.val[i]? <;> rfl

/-! ## `v_i^2 + v_i = v_(i-1)` -/

/-- The relation for every `i` in `[lo, lo + n)`, on natural numbers. -/
def relsRange (k lo n : ℕ) : Bool :=
  (List.range' lo n).all fun i =>
    towerMul k (cantorV (i + 1)) (cantorV (i + 1)) ^^^ cantorV (i + 1) == cantorV i

theorem relsRange_spec {k lo n : ℕ} (h : relsRange k lo n = true) {i : ℕ} (h1 : lo ≤ i)
    (h2 : i < lo + n) :
    towerMul k (cantorV (i + 1)) (cantorV (i + 1)) ^^^ cantorV (i + 1) = cantorV i := by
  have := List.all_eq_true.mp h i (List.mem_range'_1.mpr ⟨h1, h2⟩)
  simpa using this
theorem rels_1 : relsRange 1 0 1 = true := by decide +kernel
theorem rels_2 : relsRange 2 0 3 = true := by decide +kernel
theorem rels_3 : relsRange 3 0 7 = true := by decide +kernel
theorem rels_4 : relsRange 4 0 15 = true := by decide +kernel
theorem rels_5 : relsRange 5 0 31 = true := by decide +kernel
theorem rels_6 : relsRange 6 0 63 = true := by decide +kernel
theorem rels_7_0 : relsRange 7 0 16 = true := by decide +kernel
theorem rels_7_1 : relsRange 7 16 16 = true := by decide +kernel
theorem rels_7_2 : relsRange 7 32 16 = true := by decide +kernel
theorem rels_7_3 : relsRange 7 48 16 = true := by decide +kernel
theorem rels_7_4 : relsRange 7 64 16 = true := by decide +kernel
theorem rels_7_5 : relsRange 7 80 16 = true := by decide +kernel
theorem rels_7_6 : relsRange 7 96 16 = true := by decide +kernel
theorem rels_7_7 : relsRange 7 112 15 = true := by decide +kernel

theorem cantor_rel {k : ℕ} (hk : k ≤ 7) {i : ℕ} (hi : i + 1 < 2 ^ k) :
    towerMul k (cantorV (i + 1)) (cantorV (i + 1)) ^^^ cantorV (i + 1) = cantorV i := by
  interval_cases k
  · simp at hi
  · exact relsRange_spec rels_1 (Nat.zero_le _) (by simp at hi ⊢; omega)
  · exact relsRange_spec rels_2 (Nat.zero_le _) (by simp at hi ⊢; omega)
  · exact relsRange_spec rels_3 (Nat.zero_le _) (by simp at hi ⊢; omega)
  · exact relsRange_spec rels_4 (Nat.zero_le _) (by simp at hi ⊢; omega)
  · exact relsRange_spec rels_5 (Nat.zero_le _) (by simp at hi ⊢; omega)
  · exact relsRange_spec rels_6 (Nat.zero_le _) (by simp at hi ⊢; omega)
  · rcases (show (0 ≤ i ∧ i < 16) ∨ (16 ≤ i ∧ i < 32) ∨ (32 ≤ i ∧ i < 48) ∨ (48 ≤ i ∧ i < 64) ∨ (64 ≤ i ∧ i < 80) ∨ (80 ≤ i ∧ i < 96) ∨ (96 ≤ i ∧ i < 112) ∨ (112 ≤ i ∧ i < 127) by simp at hi; omega) with h | h | h | h | h | h | h | h
    · exact relsRange_spec rels_7_0 h.1 (by omega)
    · exact relsRange_spec rels_7_1 h.1 (by omega)
    · exact relsRange_spec rels_7_2 h.1 (by omega)
    · exact relsRange_spec rels_7_3 h.1 (by omega)
    · exact relsRange_spec rels_7_4 h.1 (by omega)
    · exact relsRange_spec rels_7_5 h.1 (by omega)
    · exact relsRange_spec rels_7_6 h.1 (by omega)
    · exact relsRange_spec rels_7_7 h.1 (by omega)

/-! ## Nesting and the choice of root -/

/-- The first `2^k` vectors lie in level `k`, for every `k ≤ 7`. -/
def nestOK : Bool :=
  (List.range 8).all fun k => (List.range (2 ^ k)).all fun i => decide (cantorV i < 2 ^ 2 ^ k)

theorem nestOK_eq : nestOK = true := by decide +kernel

theorem cantorV_lt {k : ℕ} (hk : k ≤ 7) {i : ℕ} (hi : i < 2 ^ k) : cantorV i < 2 ^ 2 ^ k := by
  have h1 := List.all_eq_true.mp nestOK_eq k (List.mem_range.mpr (by omega))
  have h2 := List.all_eq_true.mp h1 i (List.mem_range.mpr hi)
  simpa using h2

theorem cantorV_zero : cantorV 0 = 1 := rfl

/-- Each root is the one whose lowest bit is clear. -/
theorem cantorV_even : ∀ i, 1 ≤ i → i < 128 → cantorV i % 2 = 0 := by
  have h : (List.range' 1 127).all (fun i => cantorV i % 2 == 0) = true := by decide +kernel
  intro i h1 h2
  have := List.all_eq_true.mp h i (List.mem_range'_1.mpr ⟨h1, by omega⟩)
  simpa using this

