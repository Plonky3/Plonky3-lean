/-- `cantorInv k` holds the coordinates of `2^j` in the first `2^k` vectors. -/
def spanOK (k : ℕ) : Bool :=
  (List.range (2 ^ k)).all fun j =>
    lin cantorV (2 ^ k) ((cantorInv k).getD j 0) == 2 ^ j &&
      decide ((cantorInv k).getD j 0 < 2 ^ 2 ^ k)

theorem spanOK_all : (List.range 8).all spanOK = true := by decide +kernel

