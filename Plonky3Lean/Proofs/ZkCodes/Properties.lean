module

public import Plonky3Lean.Proofs.ZkCodes.Simulate

@[expose] public section

/-!
# Linearity, sampling and edge cases of the Reed-Solomon transcriptions
-/

set_option linter.unusedSectionVars false

namespace Plonky3Lean.Proofs.ZkCodes

open Finset Polynomial p3_dft.mirror Plonky3Lean.Spec.Dft Plonky3Lean.Spec.ZkCodes
open p3_zk_codes.reed_solomon.mirror Plonky3Lean.Proofs.Dft

variable {K : Type _} [Field K]

/-! ## Linearity and the generating matrix -/

theorem rsZkPoly_eval_add_smul {l t : ℕ} (a : K) (f₁ f₂ : Fin l → K) (ρ₁ ρ₂ : Fin t → K) (x : K) :
    (rsZkPoly (a • f₁ + f₂) (a • ρ₁ + ρ₂)).eval x =
      a * (rsZkPoly f₁ ρ₁).eval x + (rsZkPoly f₂ ρ₂).eval x := by
  simp only [rsZkPoly_eval, msgEval, Pi.add_apply, Pi.smul_apply, smul_eq_mul, add_mul, mul_assoc,
    sum_add_distrib, ← mul_sum]
  ring

/-- The encoding is linear in the message and the randomness together. -/
theorem encode_linear {dft_batch : ℕ → (ℕ → K) → Option (ℕ → K)} {ω : K}
    {rs : ReedSolomonZkEncoding} (hd : ∀ x, Computes (dft_batch rs.m x) rs.m (dft ω rs.m x))
    (hle : rs.msg_len + rs.t ≤ rs.m) (a : K) (f₁ f₂ : Fin rs.msg_len → K) (ρ₁ ρ₂ : Fin rs.t → K) :
    Computes (rs.encode_with_randomness dft_batch (List.ofFn (a • f₁ + f₂)) (List.ofFn (a • ρ₁ + ρ₂)))
      rs.m (fun i => a * (rsZkPoly f₁ ρ₁).eval (ω ^ i) + (rsZkPoly f₂ ρ₂).eval (ω ^ i)) := by
  obtain ⟨y, hy, hyi⟩ := encode_with_randomness_computes hd hle (List.length_ofFn) (List.length_ofFn)
  exact ⟨y, hy, fun i hi => by rw [hyi i hi]; beta_reduce; rw [encValue_ofFn, rsZkPoly_eval_add_smul]⟩

/-- The codeword at position p is the sum of two products:

- the message row times the message
- the randomness row times the randomness. -/
theorem encode_rows (G : Gen K) {t l k : ℕ} (hk : k ≤ G.adicity)
    {dft_batch : ℕ → (ℕ → K) → Option (ℕ → K)}
    (hd : ∀ x, Computes (dft_batch (2 ^ k) x) (2 ^ k) (dft (G.gen k) (2 ^ k) x))
    (hle : l + t ≤ 2 ^ k) {msg r : List K} (hmsg : msg.length = l) (hr : r.length = t) :
    ∃ y, (ReedSolomonZkEncoding.mk t l (2 ^ k)).encode_with_randomness dft_batch msg r = some y ∧
      ∀ p < 2 ^ k, ∃ mrow rrow,
        (ReedSolomonZkEncoding.mk t l (2 ^ k)).message_row G p = some mrow ∧
        (ReedSolomonZkEncoding.mk t l (2 ^ k)).randomness_row G p = some rrow ∧
        y p = (List.zipWith (· * ·) mrow msg).sum + (List.zipWith (· * ·) rrow r).sum := by
  obtain ⟨y, hy, hyi⟩ := encode_with_randomness_computes (rs := ⟨t, l, 2 ^ k⟩) (ω := G.gen k) hd hle
    hmsg hr
  refine ⟨y, hy, fun p hp => ⟨_, _, message_row_eq G hk p, randomness_row_eq G hk p, ?_⟩⟩
  rw [hyi p hp]; beta_reduce; rw [encValue_rows, hmsg, hr]

/-- The codeword is the encoding of Proposition 3.19 on the subgroup generated by G_k. -/
theorem encode_eq_rsZkEnc (G : Gen K) {t l k : ℕ} {dft_batch : ℕ → (ℕ → K) → Option (ℕ → K)}
    (hd : ∀ x, Computes (dft_batch (2 ^ k) x) (2 ^ k) (dft (G.gen k) (2 ^ k) x))
    (hle : l + t ≤ 2 ^ k) (f : Fin l → K) (ρ : Fin t → K) :
    ∃ y, (ReedSolomonZkEncoding.mk t l (2 ^ k)).encode_with_randomness dft_batch (List.ofFn f)
        (List.ofFn ρ) = some y ∧
      ∀ i : Fin (2 ^ k), y i = rsZkEnc (fun j : Fin (2 ^ k) => G.gen k ^ (j : ℕ)) f ρ i := by
  obtain ⟨y, hy, hyi⟩ := encode_with_randomness_computes (rs := ⟨t, l, 2 ^ k⟩) (ω := G.gen k) hd hle
    List.length_ofFn List.length_ofFn
  exact ⟨y, hy, fun i => by rw [hyi i i.isLt]; beta_reduce; rw [encValue_ofFn]; rfl⟩

/-! ## Sampling -/

/-- The sampled message is the first l draws, in order, for l the message length. -/
theorem sample_message_eq (rs : ReedSolomonZkEncoding) (draw : ℕ → K) :
    rs.sample_message draw = List.ofFn fun i : Fin rs.msg_len => draw i := by
  apply List.ext_getElem <;> simp [ReedSolomonZkEncoding.sample_message]

/-- The sampled randomness is the first t draws, in order. -/
theorem sample_randomness_eq (rs : ReedSolomonZkEncoding) (draw : ℕ → K) :
    rs.sample_randomness draw = List.ofFn fun i : Fin rs.t => draw i := by
  apply List.ext_getElem <;> simp [ReedSolomonZkEncoding.sample_randomness]

/-- Encoding with a generator is encoding with the sampled randomness. -/
theorem encode_eq (dft_batch : ℕ → (ℕ → K) → Option (ℕ → K)) (rs : ReedSolomonZkEncoding)
    (msg : List K) (draw : ℕ → K) :
    rs.encode dft_batch msg draw = rs.encode_with_randomness dft_batch msg (rs.sample_randomness draw) :=
  rfl

/-! ## Edge cases -/

/-- With t = 0 the randomness row is empty. -/
theorem randomness_row_t_zero (G : Gen K) {l k : ℕ} (hk : k ≤ G.adicity) (p : ℕ) :
    (ReedSolomonZkEncoding.mk 0 l (2 ^ k)).randomness_row G p = some [] := by
  rw [randomness_row_eq G hk]; rfl

/-- With t = 0 the simulator answers the empty query and panics on any other. -/
theorem simulate_t_zero (l m : ℕ) (draw : ℕ → K) (p : ℕ) (Q : List ℕ) :
    (ReedSolomonZkEncoding.mk 0 l m).simulate [] draw = some [] ∧
      (ReedSolomonZkEncoding.mk 0 l m).simulate (p :: Q) draw = none := by
  refine ⟨rfl, ?_⟩
  rw [simulate_eq]
  have : p ∈ keys (p :: Q) := mem_keys.mpr (List.mem_cons_self ..)
  have : 0 < (keys (p :: Q)).length := List.length_pos_of_mem this
  simp only [show ¬ (keys (p :: Q)).length ≤ 0 by omega, ↓reduceIte]

/-- The simulator does not range-check positions, and treats p and p + m as two positions.

The evaluation point of both is the same, and so is every generating-matrix row. -/
theorem simulate_wraps (G : Gen K) (hG : GenValid G) {t l k : ℕ} (hk : k ≤ G.adicity) (ht : 2 ≤ t)
    (p : ℕ) (draw : ℕ → K) :
    (ReedSolomonZkEncoding.mk t l (2 ^ k)).simulate [p, p + 2 ^ k] draw = some [draw 0, draw 1] ∧
      (ReedSolomonZkEncoding.mk t l (2 ^ k)).evaluation_point G (p + 2 ^ k) =
        (ReedSolomonZkEncoding.mk t l (2 ^ k)).evaluation_point G p := by
  refine ⟨?_, ?_⟩
  · rw [simulate_eq]
    have hk : keys [p, p + 2 ^ k] = [p, p + 2 ^ k] := by
      simp [keys, keysFrom]
    simp only [hk, List.length_cons, List.length_nil]
    simp [show (2 : ℕ) ≤ t from ht, List.idxOf_cons_self]
  · rw [evaluation_point_eq G hk, evaluation_point_eq G hk, pow_add, (hG k hk).pow_eq_one, mul_one]

/-- The constructor accepts m = 2^k beyond the two-adicity.

Every evaluation point then panics.

So does every encoding with a backend that panics there. -/
theorem beyond_adicity (G : Gen K) {t l k : ℕ} (hk : G.adicity < k) (hk64 : k < 64)
    (hle : l + t ≤ 2 ^ k) {dft_batch : ℕ → (ℕ → K) → Option (ℕ → K)}
    (hd : ∀ x, dft_batch (2 ^ k) x = none) (p : ℕ) (msg r : List K) :
    ReedSolomonZkEncoding.new t l (2 ^ k) = some ⟨t, l, 2 ^ k⟩ ∧
      (ReedSolomonZkEncoding.mk t l (2 ^ k)).evaluation_point G p = none ∧
      (ReedSolomonZkEncoding.mk t l (2 ^ k)).encode_with_randomness dft_batch msg r = none :=
  ⟨new_eq_some hle hk64, evaluation_point_none G hk p, encode_with_randomness_dft_none hd msg r⟩

end Plonky3Lean.Proofs.ZkCodes
