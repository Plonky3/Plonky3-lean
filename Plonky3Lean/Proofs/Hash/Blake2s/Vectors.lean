/-! ## Appendix E -/

/-- The top bytes of `n` terms of a Fibonacci sequence of words that starts from `a` and `b`. -/
def fibBytes : ℕ → ℕ → ℕ → List ℕ
  | 0, _, _ => []
  | n + 1, a, b => (a + b) % 2 ^ 32 / 2 ^ 24 :: fibBytes n b ((a + b) % 2 ^ 32)

/-- The self-test input of `len` bytes, seeded with `seed`, as the RFC's C code makes it. -/
def selftestSeq (len seed : ℕ) : List Byte := bytes (fibBytes len (0xDEAD4BAD * seed % 2 ^ 32) 1)

/-- The unkeyed digest of `outlen` bytes of the self-test input of `inlen` bytes. -/
def unkeyed (outlen inlen : ℕ) : List Byte := hash [] (selftestSeq inlen inlen) outlen

/-- The same digest, under the self-test key of `outlen` bytes. -/
def keyed (outlen inlen : ℕ) : List Byte :=
  hash (selftestSeq outlen outlen) (selftestSeq inlen inlen) outlen

/-- The 48 digests, in the RFC's order. -/
def selftestDigests : List Byte :=
  ([16, 20, 28, 32].map fun outlen =>
    ([0, 3, 64, 65, 255, 1024].map fun inlen => unkeyed outlen inlen ++ keyed outlen inlen).flatten).flatten

