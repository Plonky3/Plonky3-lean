/-!
# BLAKE2s: the test vectors of RFC 7693

- Appendix B: the digest of "abc", and the working vector before and after every round.
- Appendix E: the self-test, a digest of 48 keyed and unkeyed digests.
-/

open Plonky3Lean.Spec.Blake2s

namespace Plonky3Lean.Proofs.Blake2s

/-- Bytes written as numbers. -/
def bytes (l : List ℕ) : List Byte := l.map (BitVec.ofNat 8)

/-! ## Appendix B -/

