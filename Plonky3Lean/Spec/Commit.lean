module

public import Mathlib.LinearAlgebra.Lagrange
public import P3Commit.Types

@[expose] public section

/-!
# p3-commit: the mathematical objects

A two-adic coset is s H, for H the subgroup of order n = 2^k generated by omega:

```text
    s H = { s, s omega, s omega^2, ..., s omega^(n - 1) }
```

Its vanishing polynomial, Lagrange basis and interpolants are mathlib's.

They are taken over the points in this order.
-/

open Polynomial Finset

namespace Plonky3Lean.Spec.Commit

variable {K : Type _} [Field K]

/-- The points of the coset s H, in the order s omega^i. -/
def cosetPoints (s ω : K) (k : ℕ) : Fin (2 ^ k) → K := fun i => s * ω ^ i.val

/-- Membership in the coset s H. -/
def InCoset (s ω : K) (k : ℕ) (x : K) : Prop := ∃ i, x = cosetPoints s ω k i

/-- The monic vanishing polynomial of the coset: the product of X - x over its points. -/
noncomputable def vanishing (s ω : K) (k : ℕ) : K[X] := Lagrange.nodal univ (cosetPoints s ω k)

/-- The Lagrange basis polynomial of point i.

It has degree below n, is one at point i, and is zero at the others. -/
noncomputable def lagrange (s ω : K) (k : ℕ) (i : Fin (2 ^ k)) : K[X] :=
  Lagrange.basis univ (cosetPoints s ω k) i

/-- The interpolant of values f over the coset: the polynomial of degree below n through them. -/
noncomputable def interpolant (s ω : K) (k : ℕ) (f : Fin (2 ^ k) → K) : K[X] :=
  Lagrange.interpolate univ (cosetPoints s ω k) f

end Plonky3Lean.Spec.Commit

/-!
# The commitment-scheme contracts

A scheme is a record of its operations.

A contract is a structure of properties about them.

A concrete scheme implements the trait when its contract is proved.

The concrete schemes are p3-fri, p3-whir and p3-merkle-tree.

Binding is relative: each scheme names an event Broken under which binding may fail.

For a hash-based scheme it is a hash collision, or an unlucky challenge.

The probability of Broken is the scheme's soundness error, bounded separately.

A panic is modelled as a missing result.
-/

namespace Plonky3Lean.Spec.Commit

variable {K : Type _} [Field K]

/-! ## Univariate polynomial commitment schemes -/

open p3_commit.pcs.univariate.mirror

/-- A univariate scheme: domains with ordered points, and commit, open and verify.

Open takes, per commitment, its prover data and one list of points per matrix.

It returns values indexed by commitment, matrix, point and column.

Verify returns whether it accepts, and the challenger after it. -/
structure UnivariatePcs (K : Type _) where
  Domain : Type
  Commitment : Type
  ProverData : Type
  Proof : Type
  Challenger : Type
  size : Domain → ℕ
  point : (d : Domain) → Fin (size d) → K
  commit : List (Domain × Mat K) → Option (Commitment × ProverData)
  open_ : List (ProverData × List (List K)) → Challenger →
    Option (List (List (List (List K))) × Proof × Challenger)
  verify : List (CommitmentOpening K Commitment Domain) → Proof → Challenger →
    Option (Bool × Challenger)

namespace UnivariatePcs

variable (pcs : UnivariatePcs K)

/-- A matrix fits a domain: one row per point, at distinct points. -/
def Fits (d : pcs.Domain) (m : Mat K) : Prop :=
  m.height = pcs.size d ∧ Function.Injective (pcs.point d)

/-- The polynomial of column c: the interpolant of the column over the domain's points. -/
noncomputable def columnPoly (d : pcs.Domain) (m : Mat K) (c : Fin m.width) : K[X] :=
  Lagrange.interpolate univ (pcs.point d) fun i => m.entry i.val c

/-- The values every column of a matrix takes at a point. -/
noncomputable def columnValues (d : pcs.Domain) (m : Mat K) (z : K) : List K :=
  (List.finRange m.width).map fun c => (pcs.columnPoly d m c).eval z

/-- The true values of an opening request: per commitment, matrix, point and column. -/
noncomputable def expected (rounds : List (List (pcs.Domain × Mat K))) (pts : List (List (List K))) :
    List (List (List (List K))) :=
  (rounds.zip pts).map fun rp => (rp.1.zip rp.2).map fun dp => dp.2.map (pcs.columnValues dp.1.1 dp.1.2)

/-- The claims an honest prover sends.

They are the commitments, domains, points and opened values, in order. -/
def claims (cms : List pcs.Commitment) (rounds : List (List (pcs.Domain × Mat K)))
    (pts : List (List (List K))) (vals : List (List (List (List K)))) :
    List (CommitmentOpening K pcs.Commitment pcs.Domain) :=
  ((cms.zip rounds).zip (pts.zip vals)).map fun e =>
    ⟨e.1.1, ((e.1.2.zip e.2.1).zip e.2.2).map fun f =>
      ⟨f.1.1.1, (f.1.2.zip f.2).map fun g => ⟨g.1, g.2⟩⟩⟩

end UnivariatePcs

/-- The contract of a univariate scheme.

* Completeness: an honest opening returns the true values.
  The verifier accepts them, ending in the prover's transcript state.
* Soundness: accepted values are those of the polynomials extracted from the commitment, unless Broken.
* Degree: the extracted polynomials have degree below the domain's size.
* Honesty: for an honest commitment they are the committed columns. -/
structure UnivariatePcs.Contract (pcs : UnivariatePcs K) where
  Broken : pcs.Commitment → Prop
  extract : pcs.Commitment → ℕ → pcs.Domain → List K[X]
  completeness : ∀ (rounds : List (List (pcs.Domain × Mat K)))
      (cds : List (pcs.Commitment × pcs.ProverData)) (pts : List (List (List K)))
      (ch : pcs.Challenger),
      (∀ r ∈ rounds, ∀ dm ∈ r, pcs.Fits dm.1 dm.2) →
      List.Forall₂ (fun r cd => pcs.commit r = some cd) rounds cds →
      List.Forall₂ (fun r p => r.length = List.length p) rounds pts →
      ∃ pf ch', pcs.open_ ((cds.map Prod.snd).zip pts) ch = some (pcs.expected rounds pts, pf, ch') ∧
        pcs.verify (pcs.claims (cds.map Prod.fst) rounds pts (pcs.expected rounds pts)) pf ch =
          some (true, ch')
  soundness : ∀ (cl : List (CommitmentOpening K pcs.Commitment pcs.Domain)) pf ch ch',
      pcs.verify cl pf ch = some (true, ch') →
      ∀ o ∈ cl, ∀ m (hm : m < o.matrices.length), ∀ p ∈ o.matrices[m].points,
        p.values = (extract o.commitment m o.matrices[m].domain).map (Polynomial.eval p.point) ∨
          Broken o.commitment
  degree : ∀ cm m d, ∀ q ∈ extract cm m d, q.degree < pcs.size d
  honest : ∀ (r : List (pcs.Domain × Mat K)) cd, (∀ dm ∈ r, pcs.Fits dm.1 dm.2) →
      pcs.commit r = some cd → ∀ m (hm : m < r.length),
        extract cd.1 m r[m].1 = (List.finRange r[m].2.width).map (pcs.columnPoly r[m].1 r[m].2)

/-! ## Mixed matrix commitment schemes -/

/-- The row of a matrix of height h opened at a global index, for the tallest height H.

The index drops log_2 H - log_2 h low bits, rounding the logarithms up. -/
def rowIndex (maxHeight height index : ℕ) : ℕ :=
  index / 2 ^ (Nat.clog 2 maxHeight - Nat.clog 2 height)

/-- A mixed matrix commitment scheme over values in T.

Verify takes:

- the commitment
- each matrix's (width, height)
- the index
- the opened rows
- the proof. -/
structure Mmcs (T : Type _) where
  Commitment : Type
  ProverData : Type
  Proof : Type
  commit : List (Mat T) → Option (Commitment × ProverData)
  open_batch : ℕ → ProverData → Option (List (List T) × Proof)
  get_matrices : ProverData → List (Mat T)
  verify_batch : Commitment → List (ℕ × ℕ) → ℕ → List (List T) → Proof → Option Bool

/-- The tallest height of a batch. -/
def maxHeight {T : Type _} (ms : List (Mat T)) : ℕ := (ms.map Mat.height).foldr max 0

/-- The rows an opening at a global index returns: each matrix's row at its own index. -/
def openedRows {T : Type _} (ms : List (Mat T)) (index : ℕ) : List (List T) :=
  ms.map fun m => (List.finRange m.width).map (m.entry (rowIndex (maxHeight ms) m.height index))

/-- The contract of a mixed matrix commitment scheme.

* The prover data holds the committed matrices.
* Completeness: opening an index below the tallest height gives each matrix's row at its own index.
  That opening verifies against the matrices' dimensions.
* Binding: two accepted openings of one index under one commitment agree, unless Broken.
* Widths: an accepted row has its matrix's width. -/
structure Mmcs.Contract {T : Type _} (mmcs : Mmcs T) where
  Broken : mmcs.Commitment → Prop
  get_matrices : ∀ ms cd, mmcs.commit ms = some cd → mmcs.get_matrices cd.2 = ms
  completeness : ∀ (ms : List (Mat T)) cd (index : ℕ), mmcs.commit ms = some cd → ms ≠ [] →
      index < maxHeight ms →
      ∃ pf, mmcs.open_batch index cd.2 = some (openedRows ms index, pf) ∧
        mmcs.verify_batch cd.1 (ms.map fun m => (m.width, m.height)) index (openedRows ms index) pf =
          some true
  binding : ∀ cm dims index rows₁ rows₂ pf₁ pf₂,
      mmcs.verify_batch cm dims index rows₁ pf₁ = some true →
      mmcs.verify_batch cm dims index rows₂ pf₂ = some true →
      rows₁ = rows₂ ∨ Broken cm
  widths : ∀ cm dims index rows pf, mmcs.verify_batch cm dims index rows pf = some true →
      rows.map List.length = dims.map Prod.fst

end Plonky3Lean.Spec.Commit
