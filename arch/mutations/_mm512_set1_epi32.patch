# Mutation of: _mm512_set1_epi32
# Breaks:      it broadcasts only the low 16 bits.
#
--- a/src/x86_64/avx512.rs
+++ b/src/x86_64/avx512.rs
@@ -753,7 +753,7 @@
 /// `FOR j := 0 to 15; i := j*32; dst[i+31:i] := a[31:0]; ENDFOR; dst[MAX:512] := 0`
 #[inline]
 pub unsafe fn _mm512_set1_epi32(a: i32) -> __m512i {
-    __m512i([a as u32; 16])
+    __m512i([a as u16 as u32; 16])
 }
 
 /// `_mm512_setzero_epi32` (`vpxorq`).
